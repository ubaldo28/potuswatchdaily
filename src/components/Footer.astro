---
import { TOPICS } from '../lib/topics';
import SiteLogo from './SiteLogo.astro';

export interface Props {
  maxWidth?: string;
}
const { maxWidth = '1280px' } = Astro.props;
---
<footer class="footer">
  <div class="footer-inner" style={`max-width: ${maxWidth}`}>
    <a href="/" class="footer-logo" aria-label="POTUS Watch Daily, home"><SiteLogo compact /></a>
    <nav class="footer-links footer-regions" aria-label="Coverage areas">
      <a href="/region/americas">Americas</a>
      <a href="/region/china">China</a>
      <a href="/region/nato">NATO</a>
      <a href="/region/iran">Iran</a>
      <a href="/region/mideast">Middle East</a>
      <a href="/region/russia">Russia</a>
      <a href="/region/trade">Trade</a>
      <a href="/region/analysis">Analysis</a>
    </nav>
    <nav class="footer-links footer-regions" aria-label="Topics">
      {TOPICS.map(t => <a href={`/topic/${t.slug}`}>{t.name}</a>)}
    </nav>
    <nav class="footer-links" aria-label="Site">
      <a href="/">Home</a>
      <a href="/archive">Archive</a>
      <a href="/tracker">Tracker</a>
      <a href="/explainers/">Explainers</a>
      <a href="/newsletter">Newsletter</a>
      <a href="/about">About</a>
      <a href="/editorial">Editorial Standards</a>
      <a href="/corrections">Corrections</a>
      <a href="/contact">Contact</a>
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Service</a>
      <a href="/disclaimer">Disclaimer</a>
    </nav>
    <p class="footer-copy">&copy; 2026 POTUS Watch Daily. All rights reserved. Presidential action on tariffs, trade and sanctions.</p>
  </div>
</footer>

<style>
.footer { background: var(--navy); color: #C9D3E3; padding: 40px 24px 32px; margin-top: 64px; }
.footer-inner { margin: 0 auto; display: flex; flex-direction: column; gap: 18px; }
.footer-logo { display: inline-block; text-decoration: none; }
.footer-links { display: flex; flex-wrap: wrap; gap: 8px 22px; }
.footer-regions { padding-bottom: 14px; border-bottom: 1px solid rgba(255,255,255,.12); }
.footer-links a { display: inline-flex; align-items: center; min-height: 24px; color: #C9D3E3; font: 500 13px 'IBM Plex Sans', sans-serif; text-decoration: none; }
.footer-regions a { color: #F6F3EB; font-weight: 600; }
.footer-links a:hover { color: #F2B84B; }
.footer-copy { font: 12px 'IBM Plex Sans', sans-serif; color: #98A6BD; }
</style>
