---
export interface Props {
  backLink?: string;
  backLabel?: string;
}
const { backLink, backLabel } = Astro.props;
---
<header class="masthead">
  <div class="masthead-inner">
    <a href="/" class="logo-link">
      <img src="/logo.png" width="300" height="52" alt="POTUS Watch Daily" style="display:block">
    </a>
    <div class="masthead-right">
      <a href="/newsletter" class="btn-subscribe">Subscribe</a>
      {backLink && <a href={backLink} class="back-link">{backLabel ?? '← Back to feed'}</a>}
    </div>
  </div>
</header>

<style>
.masthead {
  background: #0a0a0a;
  border-bottom: 1px solid #1e1e1e;
  padding: 0 24px;
}
.masthead-inner {
  max-width: 1280px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64px;
}
.logo-link {
  display: flex;
  align-items: center;
  text-decoration: none;
  height: 52px;
}
.masthead-right {
  display: flex;
  align-items: center;
  gap: 16px;
}
.btn-subscribe {
  background: #cc0000;
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  padding: 7px 14px;
  border-radius: 3px;
  text-decoration: none;
  transition: background 0.15s;
}
.btn-subscribe:hover { background: #aa0000; }
.back-link {
  font-size: 12px;
  color: #555;
  text-decoration: none;
  transition: color 0.15s;
}
.back-link:hover { color: #fff; }
</style>
