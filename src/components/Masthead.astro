---
export interface Props {
  backLink?: string;
  backLabel?: string;
}
const { backLink, backLabel } = Astro.props;
const path = Astro.url.pathname;
const NAV: Array<[string, string]> = [
  ['Tracker', '/tracker'],
  ['Tariffs', '/topic/tariffs-trade-policy'],
  ['Sanctions', '/topic/sanctions-policy'],
  ['Export Controls', '/topic/export-controls-defense-trade'],
  ['Iran', '/topic/iran-nuclear-sanctions'],
  ['China', '/topic/us-china-trade-technology'],
  ['Russia', '/topic/russia-ukraine-sanctions'],
  ['Weekly Review', '/topic/weekly-review'],
];
---
<header class="masthead">
  <div class="masthead-inner">
    <a href="/" class="logo-link">
      <img src="/logo-v2.png" width="300" height="52" alt="POTUS Watch Daily" style="display:block">
    </a>
    <div class="masthead-right">
      {backLink && <a href={backLink} class="back-link">{backLabel ?? '← Back to feed'}</a>}
      <a href="/newsletter" class="btn-subscribe">Subscribe</a>
    </div>
  </div>
  <nav class="sections" aria-label="Sections">
    <div class="sections-inner">
      {NAV.map(([label, href]) => (
        <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
      ))}
    </div>
  </nav>
</header>

<style>
.masthead { background: #0a0a0a; border-bottom: 1px solid #1e1e1e; }
.masthead-inner {
  max-width: 1280px; margin: 0 auto; padding: 0 24px;
  display: flex; align-items: center; justify-content: space-between; height: 64px;
}
.logo-link { display: flex; align-items: center; text-decoration: none; height: 52px; }
.masthead-right { display: flex; align-items: center; gap: 16px; }
.btn-subscribe {
  background: #cc0000; color: #fff; font-size: 11px; font-weight: 700; letter-spacing: 0.5px;
  text-transform: uppercase; padding: 7px 14px; border-radius: 3px; text-decoration: none; transition: background 0.15s;
}
.btn-subscribe:hover { background: #aa0000; }
.back-link { font-size: 12px; color: var(--text-3); text-decoration: none; transition: color 0.15s; }
.back-link:hover { color: #fff; }
.sections { border-top: 1px solid #161616; background: #0d0d0d; }
.sections-inner {
  max-width: 1280px; margin: 0 auto; padding: 0 24px; display: flex; gap: 4px;
  overflow-x: auto; scrollbar-width: none;
}
.sections a {
  font-family: Inter, sans-serif; font-size: 12px; font-weight: 600; letter-spacing: 0.4px;
  color: var(--text-2); text-decoration: none; padding: 12px 12px; white-space: nowrap;
  border-bottom: 2px solid transparent;
}
.sections a:hover { color: #fff; }
.sections a[aria-current="page"] { color: #fff; border-bottom-color: #cc0000; }
.sections a:first-child { color: #fff; }
@media (max-width: 640px) { .masthead-inner { padding: 0 16px; } .sections-inner { padding: 0 8px; } .logo-link img { width: 200px; height: auto; } }
</style>
