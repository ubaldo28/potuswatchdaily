---
import SiteLogo from './SiteLogo.astro';
export interface Props { backLink?: string; backLabel?: string; }
const { backLink, backLabel } = Astro.props;
const path = Astro.url.pathname;
const NAV: Array<[string, string]> = [
  ['Tracker', '/tracker'],
  ['Tariffs', '/topic/tariffs-trade-policy'],
  ['Sanctions', '/topic/sanctions-policy'],
  ['Export Controls', '/topic/export-controls-defense-trade'],
  ['Iran', '/topic/iran-nuclear-sanctions'],
  ['China', '/topic/us-china-trade-technology'],
  ['Russia', '/topic/russia-ukraine-sanctions'],
  ['Weekly Review', '/topic/weekly-review'],
];
---
<header class="masthead">
  <div class="masthead-inner">
    <a href="/" class="logo-link" aria-label="POTUS Watch Daily, home"><SiteLogo /></a>
    <div class="masthead-right">
      {backLink && <a href={backLink} class="back-link">{backLabel ?? '← Back to feed'}</a>}
      <a href="/newsletter" class="btn-subscribe">Subscribe</a>
    </div>
  </div>
  <nav class="sections" aria-label="Sections">
    <div class="sections-inner">
      {NAV.map(([label, href]) => (
        <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
      ))}
    </div>
  </nav>
</header>

<style>
.masthead { background: var(--navy); color: #fff; }
.masthead-inner { max-width: 1180px; margin: 0 auto; padding: 18px 24px 14px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.logo-link { text-decoration: none; display: inline-flex; }
.masthead-right { display: flex; align-items: center; gap: 16px; }
.btn-subscribe { background: var(--accent); color: #fff; font: 700 12px 'IBM Plex Sans', sans-serif; letter-spacing: .6px; text-transform: uppercase; padding: 10px 18px; border-radius: 3px; text-decoration: none; transition: background .15s; }
.btn-subscribe:hover { background: #A02F1A; }
.back-link { font: 500 12px 'IBM Plex Sans', sans-serif; color: #AEBBD0; text-decoration: none; }
.back-link:hover { color: #fff; }
.sections { border-top: 1px solid rgba(255,255,255,.12); }
.sections-inner { max-width: 1180px; margin: 0 auto; padding: 0 16px; display: flex; gap: 2px; overflow-x: auto; scrollbar-width: none; }
.sections a { font: 600 12.5px 'IBM Plex Sans', sans-serif; color: #C9D3E3; text-decoration: none; padding: 12px 10px; white-space: nowrap; border-bottom: 3px solid transparent; }
.sections a:hover { color: #fff; }
.sections a[aria-current="page"] { color: #fff; border-bottom-color: #F2B84B; }
.sections a:first-child { color: #F2B84B; }
@media (max-width: 640px) { .masthead-inner { padding: 14px 16px 10px; } .btn-subscribe { padding: 8px 12px; font-size: 11px; } }
</style>
