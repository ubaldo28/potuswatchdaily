---
export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noIndex?: boolean;
}

const {
  title,
  description = 'Independent foreign policy intelligence. Live analysis of Trump administration diplomacy, geopolitics, and global affairs.',
  canonical,
  ogImage = 'https://www.potuswatchdaily.com/og-default.jpg',
  ogType = 'website',
  noIndex = false,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const SITE = 'https://www.potuswatchdaily.com';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl}>
  {noIndex
    ? <meta name="robots" content="noindex, nofollow">
    : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  }

  <!-- Open Graph -->
  <meta property="og:locale" content="en_US">
  <meta property="og:type" content={ogType}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={title}>
  <meta property="og:site_name" content="POTUS Watch Daily">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@POTUSwatch">
  <meta name="twitter:creator" content="@POTUSwatch">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content={title}>

  <!-- Google AdSense -->
  <meta name="google-adsense-account" content="ca-pub-7380718671497895">
  <link rel="preconnect" href="https://pagead2.googlesyndication.com">
  <link rel="preconnect" href="https://googleads.g.doubleclick.net">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7380718671497895" crossorigin="anonymous"></script>

  <!-- Favicon & theme -->
  <meta name="theme-color" content="#0a0a0a">
  <meta name="msapplication-TileColor" content="#cc0000">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.png">
  <link rel="apple-touch-icon" href="/favicon.png">

  <!-- Feeds & discovery -->
  <link rel="alternate" type="application/rss+xml" title="POTUS Watch Daily" href="/feed.xml">
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">

  <!-- Preload critical assets -->
  <link rel="preload" as="image" href={`${SITE}/logo-v2.png`} fetchpriority="high">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@400;500;600;700&display=swap">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-FRVP4L2Z2T"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-FRVP4L2Z2T');
  </script>

  <slot name="head" />
  <style is:global>
    /* ── Design tokens ─────────────────────────────────────────────────────
       Every --text-* value clears 4.5:1 against every --bg-* value, checked
       against the lightest surface (#1a1a1a) so a token is safe anywhere.
       #cc0000 is only 3.36:1 as ink, so it is a BACKGROUND colour only —
       use --accent-text when red is the text colour.                      */
    :root {
      --bg:           #0a0a0a;
      --bg-footer:    #0d0d0d;
      --bg-card:      #0e0e0e;
      --bg-raised:    #111111;
      --bg-overlay:   #161616;
      --bg-bar:       #1a1a1a;

      --text:         #f2f2f2;  /* 15.55:1 */
      --text-2:       #b3b3b3;  /*  8.30:1  body copy, excerpts, leads */
      --text-3:       #8a8a8a;  /*  5.04:1  metadata, captions, labels */

      --accent:       #cc0000;  /* background only */
      --accent-text:  #ff5c5c;  /*  5.75:1 */
      --success-text: #4caf50;  /*  6.26:1 */
      --danger-text:  #ff6b6b;  /*  6.27:1 */

      --border:       #2a2a2a;  /* decorative hairlines */
      --border-ui:    #666666;  /*  3.03:1  control boundaries, WCAG 1.4.11 */
      --focus:        #ffd400;  /* 12.16:1 */
    }

    /* 2.4.7 Focus Visible — a dark theme hides the UA ring, so restore it. */
    a:focus-visible, button:focus-visible, input:focus-visible,
    select:focus-visible, textarea:focus-visible, summary:focus-visible,
    [tabindex]:focus-visible {
      outline: 3px solid var(--focus);
      outline-offset: 2px;
      border-radius: 2px;
    }

    /* 2.4.1 Bypass Blocks — 12 tab stops precede the content on every page. */
    .skip-link {
      position: absolute; left: -9999px; top: 0; z-index: 10000;
      background: var(--accent); color: #fff; padding: 12px 20px;
      font-size: 14px; font-weight: 600; text-decoration: none;
      border-radius: 0 0 3px 0;
    }
    .skip-link:focus { left: 0; }

    .visually-hidden {
      position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
      overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%);
      white-space: nowrap; border: 0;
    }

    /* 2.3.3 Animation from Interactions */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* Shared list-page shell: archive, region hubs, static pages. Previously
       duplicated in two files and entirely absent from the region hubs, which
       therefore rendered unstyled with default-blue links at 2.11:1. */
    .page { max-width: 900px; margin: 0 auto; padding: 56px 24px 100px; }
    .eyebrow { font-size: 9px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--accent-text); margin-bottom: 12px; }
    .page-sub { font-size: 14px; color: var(--text-2); margin-bottom: 48px; }
    .crumbs { font-family: Inter, sans-serif; font-size: 11px; color: var(--text-3); margin-bottom: 20px; display: flex; gap: 8px; align-items: center; }
    .crumbs a { color: var(--text-2); text-decoration: underline; text-underline-offset: 2px; }
    .crumbs a:hover { color: var(--accent-text); }
    .region-heading { font-size: 10px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--text-3); padding-bottom: 12px; border-bottom: 1px solid var(--bg-bar); font-family: Inter, sans-serif; }
    .region-section { margin-bottom: 48px; }
    .archive-item { border-bottom: 1px solid #141414; padding: 16px 0; }
    .archive-link { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; text-decoration: none; margin-bottom: 4px; }
    .archive-title { font-family: 'Playfair Display', serif; font-size: 16px; font-weight: 700; color: #e0e0e0; line-height: 1.35; transition: color 0.15s; flex: 1; }
    .archive-link:hover .archive-title, .archive-link:focus-visible .archive-title { color: var(--accent-text); }
    .archive-meta { font-size: 11px; color: var(--text-3); white-space: nowrap; flex-shrink: 0; font-family: Inter, sans-serif; }
    .archive-excerpt { font-size: 13px; color: var(--text-3); line-height: 1.5; margin-top: 2px; font-family: Inter, sans-serif; }
    .pager { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--bg-bar); font-family: Inter, sans-serif; font-size: 13px; }
    .pager a { color: var(--accent-text); text-decoration: none; font-weight: 600; min-height: 24px; display: inline-flex; align-items: center; }
    .pager a:hover { text-decoration: underline; }
    .pager-count { color: var(--text-3); font-size: 12px; }
    .page h1 { font-family: 'Playfair Display', serif; font-size: 36px; font-weight: 900; color: var(--text); margin-bottom: 8px; }

    .masthead { background: #0a0a0a; border-bottom: 1px solid #1e1e1e; padding: 0 24px; }
    .masthead-inner { max-width: 1280px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 24px; }
    .nav { display: flex; align-items: center; }
    .nav a { color: var(--text-3); font-size: 12px; font-weight: 500; text-decoration: none; padding: 4px 12px; letter-spacing: 0.5px; text-transform: uppercase; transition: color 0.15s; white-space: nowrap; }
    .nav a:hover { color: #fff; }
    .nav a.nav-active { color: #fff; border-bottom: 2px solid #cc0000; padding-bottom: 2px; }
    .masthead-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
    .search-input-wrap { position: relative; display: flex; align-items: center; }
    .search-input-wrap svg { position: absolute; left: 9px; width: 12px; height: 12px; fill: none; stroke: #666; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; pointer-events: none; }
    .search-input-wrap input { background: #111; border: 1px solid var(--border-ui); border-radius: 3px; padding: 5px 8px 5px 28px; font-size: 11px; color: #ccc; font-family: 'Inter', sans-serif; width: 180px; transition: all 0.2s; }
    .search-input-wrap input:focus { border-color: var(--text-3); background: #111; color: #fff; width: 200px; }
    .search-input-wrap input::placeholder { color: var(--text-3); }
    .live-badge { display: flex; align-items: center; gap: 5px; font-size: 10px; font-weight: 600; letter-spacing: 1px; color: var(--accent-text); text-transform: uppercase; }
    .dot { width: 5px; height: 5px; background: #cc0000; border-radius: 50%; animation: blink 1.2s ease-in-out infinite; }
    @keyframes blink { 0%,100% { opacity:1; } 50% { opacity:0.2; } }
    .ticker-wrap { background: #111; border-bottom: 1px solid #1e1e1e; overflow: hidden; height: 32px; display: flex; align-items: center; }
    .ticker-label { background: #cc0000; color: #fff; font-size: 9px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; padding: 0 14px; height: 100%; display: flex; align-items: center; white-space: nowrap; flex-shrink: 0; }
    .ticker-track { display: flex; overflow: hidden; flex: 1; position: relative; }
    .ticker-inner { display: flex; gap: 80px; animation: ticker-scroll 40s linear infinite; white-space: nowrap; }
    @keyframes ticker-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
    .ticker-inner span { font-size: 11px; color: #aaa; font-weight: 400; }
    .ticker-inner span::before { content: '·'; margin-right: 80px; color: var(--text-3); }
    .ticker-inner span:first-child::before { display: none; }
    .tag { display: inline-block; font-size: 9px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; color: var(--accent-text); margin-bottom: 7px; }
    .section-header { display: flex; align-items: center; gap: 16px; padding: 28px 0 16px; border-top: 1px solid #1e1e1e; margin-top: 4px; }
    .section-title { font-size: 10px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--text-3); }
    .section-line { flex: 1; height: 1px; background: #1e1e1e; }
    .hero-wrap { padding: 24px 24px 0; max-width: 1280px; margin: 0 auto; }
    .hero { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; margin-bottom: 16px; }
    .hero-main { position: relative; border-radius: 4px; overflow: hidden; cursor: pointer; background: #111; text-decoration: none; color: inherit; display: block; }
    .hero-main-img { width: 100%; height: 480px; object-fit: cover; display: block; transition: transform 0.4s ease; }
    .hero-main:hover .hero-main-img { transform: scale(1.03); }
    .hero-main .overlay { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(transparent 0%, rgba(0,0,0,0.5) 30%, rgba(0,0,0,0.97) 100%); padding: 32px 28px 28px; }
    .hero-main .card-title { font-family: 'Playfair Display', serif; font-size: 30px; font-weight: 900; line-height: 1.2; color: #fff; margin-bottom: 10px; }
    .hero-main .card-excerpt { font-size: 14px; color: rgba(255,255,255,0.72); line-height: 1.6; max-width: 560px; }
    .hero-side { display: grid; grid-template-rows: 1fr 1fr; gap: 16px; }
    .hero-small { position: relative; border-radius: 4px; overflow: hidden; cursor: pointer; background: #111; text-decoration: none; color: inherit; display: block; }
    .hero-small-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; min-height: 200px; }
    .hero-small:hover .hero-small-img { transform: scale(1.03); }
    .hero-small .overlay { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(transparent, rgba(0,0,0,0.96)); padding: 20px 18px 18px; }
    .hero-small .card-title { font-family: 'Playfair Display', serif; font-size: 17px; font-weight: 700; line-height: 1.3; color: #fff; margin-bottom: 0; }
    .hero-placeholder { width: 100%; background: linear-gradient(135deg,#161616 0%,#111 100%); display: flex; align-items: center; justify-content: center; }
    .hero-placeholder-text { font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 900; color: #222; letter-spacing: 2px; text-transform: uppercase; }
    .grid-wrap { max-width: 1280px; margin: 0 auto; padding: 0 24px 48px; }
    .grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
    .card { cursor: pointer; overflow: hidden; border-radius: 4px; transition: opacity 0.2s; text-decoration: none; color: inherit; display: block; }
    .card:hover { opacity: 0.85; }
    .card-img { width: 100%; height: 190px; object-fit: cover; display: block; }
    .card-placeholder { width: 100%; height: 190px; background: #111; display: flex; align-items: center; justify-content: center; }
    .card-placeholder-inner { font-family: 'Playfair Display', serif; font-size: 13px; font-weight: 700; color: #2a2a2a; letter-spacing: 3px; text-transform: uppercase; }
    .card-body { padding: 16px 0 4px; }
    .card-title { font-family: 'Playfair Display', serif; font-size: 17px; font-weight: 700; line-height: 1.35; color: #e8e8e8; margin-bottom: 8px; }
    .card-excerpt { font-size: 13px; color: var(--text-3); line-height: 1.6; }
    .card-meta { font-size: 11px; color: var(--text-3); margin-top: 10px; }
    .cookie-banner { display: none; position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); background: #161616; border: 1px solid var(--border-ui); border-radius: 6px; padding: 16px 20px; z-index: 9999; align-items: center; gap: 20px; max-width: 560px; width: calc(100% - 48px); box-shadow: 0 4px 40px rgba(0,0,0,0.6); }
    .cookie-banner p { font-size: 12px; color: var(--text-3); margin: 0; flex: 1; line-height: 1.5; }
    .cookie-banner a { color: var(--accent-text); }
    .cookie-actions { display: flex; gap: 8px; flex-shrink: 0; }
    .btn-accept { background: #cc0000; color: #fff; border: none; padding: 7px 16px; border-radius: 3px; font-size: 11px; font-weight: 600; cursor: pointer; letter-spacing: 0.5px; }
    .btn-decline { background: none; color: var(--text-3); border: 1px solid var(--border-ui); padding: 7px 14px; border-radius: 3px; font-size: 11px; cursor: pointer; }
    @media(max-width:900px) { .nav { display: none; } .hero { grid-template-columns: 1fr; } .hero-main-img { height: 360px; } .hero-side { grid-template-rows: auto auto; grid-template-columns: 1fr 1fr; } }
    @media(max-width:640px) { .search-input-wrap { display: none; } .grid { grid-template-columns: 1fr; gap: 16px; } .masthead-inner { height: 52px; } .hero-side { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  <div class="top-bar"></div>
  <slot />
  <!-- Adsterra async ad scripts -->
  <script async src="https://pl29502765.effectivecpmnetwork.com/37/c5/f9/37c5f97dcf85aef347afb415f071ce90.js"></script>
  <script async src="https://pl29502766.effectivecpmnetwork.com/05/06/4c/05064cd4192c96a0884ae0f79145c863.js"></script>
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', sans-serif;
      background: #0a0a0a;
      color: #fff;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }
    .top-bar { height: 3px; background: #cc0000; }
  </style>
</body>
</html>
