---
export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noIndex?: boolean;
}

const {
  title,
  description = 'Tracking every presidential action on tariffs, trade and sanctions, with analysis of what each one changes.',
  canonical,
  ogImage = 'https://www.potuswatchdaily.com/og-default.jpg',
  ogType = 'website',
  noIndex = false,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

// The commit this page was built from, stamped in at build time. It exists for
// one reason: from 2026-09-05 to 2026-09-09 the live site served a build four
// days old and nothing noticed. The health check watched the live domain and it
// watched the generator, and both were green the whole time, because articles
// come from the database and kept arriving. Nothing compared what was DEPLOYED
// with what was in the repository, so four days of security headers, structured
// data and an unsubscribe endpoint sat in a Worker no reader could reach.
//
// PUBLIC_BUILD_SHA, not GITHUB_SHA: Astro inlines PUBLIC_-prefixed variables
// into the bundle at build time. process.env would be read at REQUEST time
// inside the Worker, where it is empty -- every page would ship a blank stamp
// and the check would report "no stamp" forever, which is exactly the silent
// failure this is here to prevent.
const buildSha = (import.meta.env.PUBLIC_BUILD_SHA ?? '').slice(0, 40);
const SITE = 'https://www.potuswatchdaily.com';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {buildSha && <meta name="pw-build" content={buildSha} />}
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl}>
  {noIndex
    ? <meta name="robots" content="noindex, follow">
    : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  }

  <!-- Open Graph -->
  <meta property="og:locale" content="en_US">
  <meta property="og:type" content={ogType}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={title}>
  <meta property="og:site_name" content="POTUS Watch Daily">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@POTUSwatch">
  <meta name="twitter:creator" content="@POTUSwatch">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content={title}>

  <!-- Google AdSense -->
  <meta name="google-adsense-account" content="ca-pub-7380718671497895">
  <link rel="preconnect" href="https://pagead2.googlesyndication.com">
  <link rel="preconnect" href="https://googleads.g.doubleclick.net">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7380718671497895" crossorigin="anonymous"></script>

  <!-- Favicon & theme -->
  <meta name="theme-color" content="#0B2545">
  <meta name="msapplication-TileColor" content="#C23B22">
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <!-- Feeds & discovery -->
  <link rel="alternate" type="application/rss+xml" title="POTUS Watch Daily" href="/feed.xml">
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">

  <!-- Preload critical assets -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,700;6..72,800&display=swap">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,700;6..72,800&display=swap" rel="stylesheet">

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-FRVP4L2Z2T"></script>
  <script is:inline>
    // is:inline matters: without it Astro hoists this into an external
    // type="module" bundle, gtag() becomes module-scoped, window.gtag is
    // undefined, and every later gtag() call -- including the consent updates
    // from the banner -- silently does nothing.
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.gtag = gtag;
    // Denied until the visitor says otherwise. The banner used to appear three
    // seconds AFTER these tags had already set their cookies, and Decline only
    // hid the div.
    gtag('consent', 'default', {
      ad_storage: 'denied', ad_user_data: 'denied',
      ad_personalization: 'denied', analytics_storage: 'denied',
      wait_for_update: 500
    });
    gtag('js', new Date());
    gtag('config', 'G-FRVP4L2Z2T');
  </script>

  <slot name="head" />
  <style is:global>
    /* Design tokens: "The Ledger". Paper ground, ink text, navy chrome,
       vermilion as the single loud accent. Every text token clears 4.5:1 on
       --bg and --bg-card. --accent is a BACKGROUND colour (white on it is
       5:1); use --accent-text when red is the text colour. */
    :root {
      --bg:           #F6F3EB;
      --bg-card:      #FFFFFF;
      --bg-raised:    #FFFFFF;
      --bg-sunk:      #EDE8DA;
      --bg-bar:       #E4DFD0;
      --bg-footer:    #0B2545;
      --bg-overlay:   #FFFFFF;

      --text:         #10141B;
      --text-2:       #353C4A;
      --text-3:       #5E6474;

      --navy:         #0B2545;
      --navy-2:       #153A6B;
      --gold:         #F2B84B;
      --accent:       #C23B22;
      --accent-dark:  #A02F1A;
      --accent-text:  #B3321B;
      --link:         #144A8C;
      --success-text: #17603A;
      --danger-text:  #B3261E;

      --border:       #D8D2C2;
      --border-ui:    #8A8576;
      --focus:        #0B57D0;

      --serif: 'Newsreader', Georgia, 'Times New Roman', serif;
      --sans:  'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
      --mono:  'IBM Plex Mono', ui-monospace, Menlo, monospace;
    }

    a:focus-visible, button:focus-visible, input:focus-visible,
    select:focus-visible, textarea:focus-visible, summary:focus-visible,
    [tabindex]:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 2px; }

    .skip-link { position: absolute; left: -9999px; top: 0; z-index: 10000; background: var(--accent); color: #fff; padding: 12px 20px; font: 600 14px var(--sans); text-decoration: none; border-radius: 0 0 3px 0; }
    .skip-link:focus { left: 0; }
    .visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; border: 0; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
    }

    /* Shared list-page shell: archive, topic hubs, static pages. */
    .page { max-width: 860px; margin: 0 auto; padding: 56px 24px 100px; }
    .eyebrow { font: 700 11px var(--sans); letter-spacing: 2px; text-transform: uppercase; color: var(--accent-text); margin-bottom: 12px; }
    .page-sub { font: 16px/1.6 var(--sans); color: var(--text-2); margin-bottom: 40px; }
    .crumbs { font: 12px var(--sans); color: var(--text-3); margin-bottom: 20px; display: flex; gap: 8px; align-items: center; }
    .crumbs a { color: var(--text-2); text-decoration: underline; text-underline-offset: 2px; }
    .crumbs a:hover { color: var(--accent-text); }
    .region-heading { font: 700 11px var(--sans); letter-spacing: 2px; text-transform: uppercase; color: var(--text-3); padding-bottom: 12px; border-bottom: 1px solid var(--border); }
    .region-section { margin-bottom: 48px; }
    .archive-item { border-bottom: 1px solid var(--border); padding: 18px 0; }
    .archive-link { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; text-decoration: none; margin-bottom: 4px; }
    .archive-title { font: 700 19px/1.3 var(--serif); color: var(--text); flex: 1; }
    .archive-link:hover .archive-title, .archive-link:focus-visible .archive-title { color: var(--accent-text); }
    .archive-meta { font: 12px var(--mono); color: var(--text-3); white-space: nowrap; flex-shrink: 0; }
    .archive-excerpt { font: 15px/1.55 var(--sans); color: var(--text-2); margin-top: 4px; }
    .pager { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--border); font: 14px var(--sans); }
    .pager a { color: var(--link); text-decoration: none; font-weight: 600; min-height: 24px; display: inline-flex; align-items: center; }
    .pager a:hover { text-decoration: underline; }
    .pager-count { color: var(--text-3); font-size: 13px; }
    .page h1 { font: 800 clamp(30px, 5vw, 42px)/1.12 var(--serif); color: var(--text); margin-bottom: 10px; letter-spacing: -0.3px; }
    .page a { color: var(--link); text-decoration: underline; text-underline-offset: 2px; }

    .cookie-banner { display: none; position: fixed; bottom: 0; left: 0; right: 0; background: var(--navy); color: #E6ECF5; padding: 9px 16px; z-index: 9999; align-items: center; justify-content: center; gap: 16px; box-shadow: 0 -2px 20px rgba(11,37,69,0.35); }
    .cookie-banner p { font: 12px/1.4 var(--sans); color: #E6ECF5; margin: 0; }
    .cookie-banner a { color: var(--gold); }
    .cookie-actions { display: flex; gap: 8px; flex-shrink: 0; }
    .btn-accept { background: var(--accent); color: #fff; border: none; padding: 7px 16px; border-radius: 3px; font: 600 12px var(--sans); cursor: pointer; }
    .btn-decline { background: none; color: #E6ECF5; border: 1px solid rgba(255,255,255,.45); padding: 7px 14px; border-radius: 3px; font: 12px var(--sans); cursor: pointer; }
    @media (max-width: 640px) { .cookie-banner { gap: 10px; padding: 8px 12px; } .cookie-banner p { font-size: 11px; } .btn-accept, .btn-decline { padding: 6px 12px; } }
  </style>
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
    <slot />
  <!-- Consent, and the ad scripts it actually governs.

       Two things were wrong here. The banner lived in index.astro, so it
       appeared on the home page and nowhere else -- and search traffic lands on
       articles, not the home page, which means most visitors were never asked.
       And these two Adsterra tags loaded unconditionally on every page. Google
       Consent Mode does not reach them, so "Decline" left them running while
       the banner said the site was asking about personalised ads.

       The banner is now in the layout, so it is on every page, and these two
       scripts are injected only after the visitor accepts. -->
  <div class="cookie-banner" id="cookie-banner" role="dialog" aria-modal="false"
       aria-labelledby="cookie-banner-text" aria-live="polite">
    <p id="cookie-banner-text">We use cookies for ads (Google AdSense) and analytics. <a href="/privacy">Privacy</a> · <a href="https://adssettings.google.com" target="_blank" rel="noopener">Opt out</a></p>
    <div class="cookie-actions">
      <button class="btn-accept" onclick="acceptCookies()">Accept</button>
      <button class="btn-decline" onclick="declineCookies()">Decline</button>
    </div>
  </div>

  <script is:inline>
    // is:inline for the same reason the gtag block needs it: Astro would
    // otherwise hoist this into a module and the onclick handlers above would
    // find no such function.
    // Adsterra tags removed until AdSense approval. Re-add URLs here to restore.
    var PW_AD_TAGS = [];
    function pwLoadAdTags() {
      if (window.__pwAdTagsLoaded) return;
      window.__pwAdTagsLoaded = true;
      PW_AD_TAGS.forEach(function (src) {
        var el = document.createElement('script');
        el.async = true; el.src = src;
        document.body.appendChild(el);
      });
    }

    function setConsent(granted) {
      try { localStorage.setItem('cookies', granted ? '1' : '0'); } catch (e) {}
      var b = document.getElementById('cookie-banner');
      if (b) b.style.display = 'none';
      if (window.gtag) {
        var v = granted ? 'granted' : 'denied';
        gtag('consent', 'update', { ad_storage: v, ad_user_data: v, ad_personalization: v, analytics_storage: v });
      }
      if (granted) pwLoadAdTags();
    }
    function acceptCookies() { setConsent(true); }
    function declineCookies() { setConsent(false); }

    // Shown immediately, not after three seconds. A consent prompt that arrives
    // once the tags have already run is not a consent prompt.
    (function () {
      var stored = null;
      try { stored = localStorage.getItem('cookies'); } catch (e) {}
      if (stored === null) {
        var b = document.getElementById('cookie-banner');
        if (b) b.style.display = 'flex';
        return;
      }
      var v = stored === '1' ? 'granted' : 'denied';
      if (window.gtag) gtag('consent', 'update', { ad_storage: v, ad_user_data: v, ad_personalization: v, analytics_storage: v });
      if (stored === '1') pwLoadAdTags();
    })();
  </script>
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { -webkit-text-size-adjust: 100%; }
    body { font-family: var(--sans); background: var(--bg); color: var(--text); min-height: 100vh; -webkit-font-smoothing: antialiased; line-height: 1.5; }
  </style>
</body>
</html>
