---
import { env } from 'cloudflare:workers';
import { createClient } from '@supabase/supabase-js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import Masthead from '../../components/Masthead.astro';
import { isRoutineNotice } from '../../lib/quality';
import { topicsFor } from '../../lib/topics';
import BrandCard from '../../components/BrandCard.astro';
import { classify, getOrder } from '../../lib/actions';
import { sourceLabel } from '../../lib/quality';

// env comes from the Workers runtime module (Astro.locals.runtime was removed in adapter v14)
const supabase = createClient(env.SUPABASE_URL, env.SUPABASE_KEY);
const { slug } = Astro.params;

const { data: a, error } = await supabase
  .from('articles')
  .select('*')
  .eq('slug', slug)
  .limit(1)
  .single();

if (error || !a) {
  return new Response(
    `<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Not Found — POTUS Watch Daily</title><meta name="robots" content="noindex"><link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%230B2545'/><circle cx='16' cy='16' r='12' fill='none' stroke='%23C23B22' stroke-width='2.5'/><circle cx='16' cy='16' r='4' fill='%23C23B22'/></svg>"></head><body style="background:#F6F3EB;color:#fff;font-family:sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;gap:16px;text-align:center"><div style="height:3px;background:#C23B22;position:fixed;top:0;left:0;right:0"></div><h1 style="font-size:72px;font-weight:900;color:#B3321B;margin:0">404</h1><p style="font-size:18px;color:#5E6474">Dispatch not found.</p><a href="/" style="color:#B3321B;font-size:13px;text-decoration:none;border:1px solid #C23B22;padding:8px 20px;border-radius:3px">← Back to the feed</a></body></html>`,
    { status: 404, headers: { 'Content-Type': 'text/html; charset=utf-8' } }
  );
}

// Taken off the site on purpose: say so (410 Gone) instead of pretending it never existed,
// so search engines drop the URL. Restore by clearing removed_at in the database.
if (a.removed_at) {
  return new Response(
    `<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Removed — POTUS Watch Daily</title><meta name="robots" content="noindex"></head><body style="background:#F6F3EB;color:#10141B;font-family:system-ui,sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;gap:16px;text-align:center;padding:24px"><div style="height:4px;background:#C23B22;position:fixed;top:0;left:0;right:0"></div><h1 style="font-size:40px;margin:0">Removed</h1><p style="font-size:17px;color:#353C4A;max-width:30rem">This article is no longer on POTUS Watch Daily.</p><a href="/" style="color:#fff;background:#0B2545;font-size:14px;text-decoration:none;padding:10px 22px;border-radius:3px">Back to the front page</a></body></html>`,
    { status: 410, headers: { 'Content-Type': 'text/html; charset=utf-8', 'X-Robots-Tag': 'noindex' } }
  );
}

const REGION_ALIASES: Record<string, string[]> = { 'Mideast': ['Mideast', 'Middle East'], 'Middle East': ['Mideast', 'Middle East'] };
const aliases = a.region ? (REGION_ALIASES[a.region] ?? [a.region]) : null;

const relatedQuery = supabase
  .from('articles')
  .select('title,slug,region,image,date')
  .neq('slug', slug ?? '')
  .is('removed_at', null)
  .order('id', { ascending: false })
  .limit(6);
if (aliases) relatedQuery.in('region', aliases);

const [{ data: related = [] }, { data: prevA }, { data: nextA }] = await Promise.all([
  relatedQuery,
  supabase.from('articles').select('title,slug').is('removed_at', null).lt('id', a.id).order('id', { ascending: false }).limit(1).maybeSingle(),
  supabase.from('articles').select('title,slug').is('removed_at', null).gt('id', a.id).order('id', { ascending: true }).limit(1).maybeSingle(),
]);

const topics = topicsFor(a.title).slice(0, 2);
const TIMELINE: Record<string, string> = {
  'tariffs-trade-policy': 'tariffs', 'sanctions-policy': 'sanctions', 'export-controls-defense-trade': 'export-controls',
  'us-china-trade-technology': 'china', 'iran-nuclear-sanctions': 'iran', 'russia-ukraine-sanctions': 'russia',
};
const SITE_URL = 'https://www.potuswatchdaily.com';
const canonicalUrl = `${SITE_URL}/article/${a.slug}`;
const img = a.hero_image || a.image || `${SITE_URL}/og-default.jpg`;

// The generator encodes the Unsplash photographer into the image URL (the
// articles table has no column for it). Unsplash ignores the extra params.
let photoCredit: { name: string; url: string; src: string } | null = null;
try {
  // Older rows have "?pw_src=" appended to a URL that already had a query, so the
  // credit parameters hide inside the previous value. Re-join them.
  const first = img.indexOf('?');
  const fixed = first !== -1 && img.indexOf('?pw_src=') > first ? img.replace('?pw_src=', '&pw_src=') : img;
  const q = new URL(fixed).searchParams;
  const by = q.get('pw_by'), at = q.get('pw_at'), src = q.get('pw_src') || 'unsplash';
  if (by && at) photoCredit = { name: by, url: at, src };
} catch {}
const region = a.region || 'Analysis';
const regionSlug = region.toLowerCase() === 'middle east' ? 'mideast' : region.toLowerCase().replace(/\s+/g, '-');
const dateIso = a.published_at || a.created_at || new Date().toISOString();
const words = (a.body || '').trim().split(/\s+/).filter(Boolean).length;
const readTime = Math.max(1, Math.round(words / 200)) + ' min read';
const desc = (a.meta_description || a.excerpt || '').replace(/"/g, '&quot;');

function esc(s: string | null | undefined) {
  return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// Inline formatting after escaping: **bold**, and links to OTHER articles on
// this site only (the weekly roundup writes them). Anything else stays text.
const inline = (t: string) => esc(t)
  .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
  .replace(/\[([^\]]+)\]\((\/article\/[a-z0-9-]+)\)/g, '<a href="$2">$1</a>');

const lines = (a.body || '').split(/\n+/).filter(Boolean);
let paras = '';
for (let i = 0; i < lines.length; i++) {
  const p = lines[i];
  if (p.startsWith('## ')) paras += `<h2>${esc(p.slice(3))}</h2>`;
  else if (p.startsWith('# ')) paras += `<h2>${esc(p.slice(2))}</h2>`;
  else if (/^[-*] /.test(p)) {
    const items: string[] = [];
    while (i < lines.length && /^[-*] /.test(lines[i])) items.push(`<li>${inline(lines[i].slice(2))}</li>`), i++;
    i--;
    paras += `<ul class="facts">${items.join('')}</ul>`;
  } else paras += `<p>${inline(p)}</p>`;
}

let sources: { url: string; title: string }[] = [];
try { sources = JSON.parse(a.sources || '[]'); } catch {}

// A source that is a presidential document also has its own page here, with the
// official text. Link it, so the article and the order reinforce each other.
const frDocs = [...new Set(sources.map(s => (String(s.url).match(/federalregister\.gov\/documents\/\d{4}\/\d\d\/\d\d\/(\d{4}-\d{4,6})\//) || [])[1]).filter(Boolean))].slice(0, 3) as string[];
const orders = (await Promise.all(frDocs.map(d => getOrder(d)))).filter(Boolean) as NonNullable<Awaited<ReturnType<typeof getOrder>>>[];

const encodedUrl = encodeURIComponent(canonicalUrl);
const encodedTitle = encodeURIComponent(a.title || '');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": String(a.title || "").slice(0, 110),
  "description": a.meta_description || a.excerpt,
  "image": [img],
  "datePublished": dateIso,
  "dateModified": a.updated_at || dateIso,
  "author": [{ "@type": "NewsMediaOrganization", "name": "POTUS Watch Daily", "url": SITE_URL, "description": "Automated analysis drafted from primary documents and cited to its sources." }],
  "publisher": { "@type": "NewsMediaOrganization", "name": "POTUS Watch Daily", "url": SITE_URL, "logo": { "@type": "ImageObject", "url": `${SITE_URL}/logo-v3.png`, "width": 1200, "height": 208 } },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
  "articleSection": region,
  "wordCount": words,
  "inLanguage": "en-US",
  "isAccessibleForFree": true
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE_URL },
    { "@type": "ListItem", "position": 2, "name": region, "item": `${SITE_URL}/region/${regionSlug}` },
    { "@type": "ListItem", "position": 3, "name": a.title }
  ]
};

// JSON.stringify escapes quotes and backslashes but NOT '<', so a title
// containing </script> closes the element and injects markup. Article titles
// are LLM output derived from third-party feeds, so this is reachable.
const safeJsonLd = (o: unknown) => JSON.stringify(o)
  .replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');

// Source URLs and image URLs come from third-party feeds and LLM output.
// Astro escapes the attribute value but does not validate the scheme, so
// javascript: would survive into href. Allow http/https only.
const safeUrl = (u: string | null | undefined) => {
  try {
    const parsed = new URL(String(u));
    return parsed.protocol === 'http:' || parsed.protocol === 'https:' ? parsed.href : null;
  } catch { return null; }
};

/**
 * A responsive srcset that is actually responsive.
 *
 * The old form was three `img.replace(/&w=\d+/, ...)` calls. String.replace with
 * a non-global regex matches `&w=NNN` only, so any URL where `w` was the FIRST
 * query parameter -- or where there was no `w` at all -- produced three
 * byte-identical URLs advertised at 640w, 1024w and 1600w. A phone then
 * downloaded the full-resolution image believing it was the small one.
 */
const srcsetFor = (u: string) => {
  try {
    return [640, 1024, 1600].map(w => {
      const url = new URL(u);
      url.searchParams.set('w', String(w));
      return `${url.href} ${w}w`;
    }).join(', ');
  } catch { return undefined; }
};

/**
 * safeUrl() can return null, and the old code interpolated it straight into a
 * template literal -- producing href="null?utm_source=..." , a relative link to
 * /null that 404s. It also appended `?` unconditionally, corrupting any credit
 * URL that already carried a query string.
 */
const creditUrl = (u: string | null | undefined) => {
  const safe = safeUrl(u);
  if (!safe) return null;
  try {
    const url = new URL(safe);
    url.searchParams.set('utm_source', 'potuswatch');
    url.searchParams.set('utm_medium', 'referral');
    return url.href;
  } catch { return null; }
};
const creditHref = creditUrl(photoCredit?.url);
---
<BaseLayout
  title={a.title && a.title.length > 48 ? a.title : `${a.title} — POTUS Watch Daily`}
  description={a.meta_description || a.excerpt || ''}
  canonical={canonicalUrl}
  ogImage={img}
  ogType="article"
  noIndex={isRoutineNotice(a.title)}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={safeJsonLd(jsonLd)} />
    <script type="application/ld+json" set:html={safeJsonLd(breadcrumbLd)} />
    <meta property="article:published_time" content={dateIso} />
    <meta property="article:modified_time" content={a.updated_at || dateIso} />
    <meta property="article:section" content={region} />
    <meta property="article:author" content="POTUS Watch Daily" />
    <meta name="news_keywords" content={`${region}, foreign policy, diplomacy, geopolitics, POTUS Watch Daily`} />
  </Fragment>

  <Masthead />
  <div class="editorial-bar">Analysis drafted from primary documents and cited to its sources. See <a href="/editorial">how we make this</a>.</div>

  {img && img !== `${SITE_URL}/og-default.jpg` && (
  <Fragment>
    <img class="hero-img" src={img} srcset={srcsetFor(img)} sizes="100vw" width="1600" height="640" alt="" fetchpriority="high" decoding="async" />
    {photoCredit && photoCredit.src === 'gov' && (
      <p class="photo-credit">
        Photo: <a href={safeUrl(photoCredit.url)} target="_blank" rel="noopener">{photoCredit.name}</a>
        <span class="photo-credit-note"> — public domain (17 U.S.C. § 105).</span>
      </p>
    )}
    {photoCredit && photoCredit.src === 'commons' && creditHref && (
      <p class="photo-credit">
        File photo: <a href={creditHref} target="_blank" rel="noopener nofollow">{photoCredit.name}</a>
        <span class="photo-credit-note"> via Wikimedia Commons. Illustrative; not necessarily taken at the events described.</span>
      </p>
    )}
    {photoCredit && photoCredit.src === 'unsplash' && creditHref && (
      <p class="photo-credit">
        Photo by <a href={creditHref} target="_blank" rel="noopener nofollow">{photoCredit.name}</a>
        {' '}on <a href="https://unsplash.com/?utm_source=potuswatch&utm_medium=referral" target="_blank" rel="noopener nofollow">Unsplash</a>
        <span class="photo-credit-note"> — illustrative stock image, not a depiction of the events described.</span>
      </p>
    )}
  </Fragment>
  )}
  {!(img && img !== `${SITE_URL}/og-default.jpg`) && (
    <BrandCard size="band" tag={classify(a.title) === 'Other' ? 'Analysis' : classify(a.title)} label={sourceLabel(a.sources, a.region)} />
  )}

  <main id="main" class="article-content" tabindex="-1">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">›</span> <a href={`/region/${regionSlug}`}>{region}</a>
    </nav>
    <div class="eyebrow">
      <span class="tag">{region}</span>
      <span style="color:var(--border)">·</span>
      <span class="byline-meta"><a href="/about" rel="author">POTUS Watch Daily</a> · automated analysis · <time datetime={dateIso}>{a.date || ''}</time>{a.time ? ` · ${a.time}` : ''} · {readTime}</span>
    </div>
    <h1>{a.title}</h1>
    <hr>
    <div class="article-body" set:html={paras} />

    <div class="support-box">
      <p class="support-title">Keep the dispatches coming</p>
      <p class="support-sub">POTUS Watch Daily is independent and reader-supported. If this briefing was useful, a coffee keeps the lights on.</p>
      <a href="https://www.buymeacoffee.com/POTUSwatch" target="_blank" rel="noopener" class="btn-coffee">☕ Buy me a coffee</a>
    </div>

    {topics.length > 0 && (
      <p class="topic-links">Follow this story: {topics.map(t => <a href={`/topic/${t.slug}`}>{t.name}</a>)}{topics.map(t => TIMELINE[t.slug]).filter(Boolean).slice(0, 1).map(l => <> · <a href={`/timeline/${l}`}>Every presidential order on this</a></>)}</p>
    )}

    {sources.length > 0 && (
      <div class="sources">
        {orders.length > 0 && <p class="sources-label">Official text on this site</p>}
        {orders.map(o => <a href={`/order/${o.doc}`}>{o.label}: {o.title}</a>)}
        {orders.length > 0 && <p class="sources-label" style="margin-top:18px">Sources</p>}
        {orders.length === 0 && <p class="sources-label">Sources</p>}
        <p class="sources-note">Documents and reporting this dispatch draws on, cited by number in the text above.</p>
        {sources.filter(s => safeUrl(s.url)).map(s => <a href={safeUrl(s.url)} target="_blank" rel="noopener">{(s as any).outlet ? `${(s as any).outlet}: ` : ''}{s.title}</a>)}
      </div>
    )}

    <div class="share-row">
      <span class="share-label">Share</span>
      <a href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`} target="_blank" rel="noopener" class="icon-btn" aria-label="Share on X">
        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`} target="_blank" rel="noopener" class="icon-btn" aria-label="Share on Facebook">
        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </a>
      <a href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodedUrl}&title=${encodedTitle}`} target="_blank" rel="noopener" class="icon-btn" aria-label="Share on LinkedIn">
        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href={`https://reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`} target="_blank" rel="noopener" class="icon-btn" aria-label="Share on Reddit">
        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/></svg>
      </a>
    </div>

    {related && related.length > 0 && (
      <div class="related-section">
        <p class="related-label">More from {region}</p>
        <div class="related-grid">
          {related.map(r => (
            <a href={`/article/${r.slug}`} class="related-card">
              {r.image && <img src={r.image} alt="" class="related-img" width="400" height="120" loading="lazy" />}
              <div class="related-region">{r.region || ''}</div>
              <div class="related-title-text">{r.title}</div>
              <div class="related-date">{r.date || ''}</div>
            </a>
          ))}
        </div>
      </div>
    )}

    {(prevA || nextA) && (
      <nav class="seq" aria-label="More dispatches">
        {prevA ? <a class="seq-link" href={`/article/${prevA.slug}`}><span class="seq-dir">← Previous dispatch</span><span class="seq-title">{prevA.title}</span></a> : <span></span>}
        {nextA ? <a class="seq-link seq-next" href={`/article/${nextA.slug}`}><span class="seq-dir">Next dispatch →</span><span class="seq-title">{nextA.title}</span></a> : <span></span>}
      </nav>
    )}
  </main>

  <Footer />
</BaseLayout>

<style>
.editorial-bar a { color: var(--link); } .editorial-bar { background: var(--bg-sunk); border-bottom: 1px solid var(--border); padding: 6px 24px; font-size: 10px; color: var(--text-3); letter-spacing: 1px; font-family: IBM Plex Sans, Arial, sans-serif; text-transform: uppercase; }
.article-body :global(.facts) { margin: 0 0 20px 1.2em; padding: 0; color: var(--text); font-family: 'Newsreader', Georgia, serif; font-size: 17px; }
.article-body :global(.facts li) { margin-bottom: 8px; line-height: 1.7; }
.article-body :global(a) { color: var(--accent-text); }
.topic-links { margin: 28px 0 0; font-size: 13px; color: var(--text-3); font-family: IBM Plex Sans, sans-serif; }
.topic-links a { color: var(--accent-text); margin-right: 14px; }
.hero-img { width: 100%; height: 480px; max-height: 480px; aspect-ratio: 5 / 2; object-fit: cover; display: block; }
@media (max-width: 640px) { .hero-img { height: 220px; } }
.article-content { max-width: 740px; margin: 0 auto; padding: 40px 24px 80px; }
.photo-credit { font-family: IBM Plex Sans, Arial, sans-serif; font-size: 11px; color: var(--text-3); margin: 8px auto 0; max-width: 740px; padding: 0 24px; }
.photo-credit a { color: var(--text-3); text-decoration: none; }
.photo-credit a:hover { color:var(--accent-text); text-decoration: underline; }
.photo-credit-note { color: var(--text-3); }
.crumbs { font-family: IBM Plex Sans, Arial, sans-serif; font-size: 11px; color: var(--text-3); margin-bottom: 20px; display: flex; gap: 8px; align-items: center; }
.crumbs a { color: var(--text-3); text-decoration: none; }
.crumbs a:hover { color:var(--accent-text); }
.seq { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--border); }
