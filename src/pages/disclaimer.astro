---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Disclaimer — POTUS Watch Daily" canonical="https://www.potuswatchdaily.com/disclaimer">
  <Masthead backLink="/" backLabel="← Back to feed" />
  <main id="main" class="page" tabindex="-1">
    <div class="eyebrow">Legal</div>
    <h1>Disclaimer</h1>
    <p class="updated">Last updated: April 2026</p>
    <hr>
    <h2>Informational Purposes Only</h2>
    <p>All content published on POTUS Watch Daily is intended for general informational and educational purposes only. Nothing on this site constitutes legal, financial, political, or professional advice of any kind.</p>
    <h2>Editorial Independence</h2>
    <p>POTUS Watch Daily operates independently with no corporate sponsors, investors, or editorial board. Our analysis reflects our own editorial perspective and should be understood as commentary and opinion rather than verified fact.</p>
    <h2>Accuracy of Information</h2>
    <p>While we make every effort to ensure the information published is accurate and up to date, news and geopolitical situations can change rapidly. We recommend readers cross-reference information with primary sources.</p>
    <h2>Third Party Links</h2>
    <p>Articles may contain links to third party websites provided for reference and context only. Inclusion of a link does not imply endorsement.</p>
    <h2>Affiliate Links</h2>
    <p>This site contains affiliate links. If you make a purchase through an affiliate link we may earn a commission at no additional cost to you.</p>
    <h2>Advertising</h2>
    <p>This site may display third party advertisements. Advertisers have no editorial influence over our content.</p>
    <h2>No Liability</h2>
    <p>POTUS Watch Daily and its operators shall not be held liable for any loss or damage arising from your use of this website or reliance on any content published here.</p>
    <h2>Coverage of Armed Conflict</h2>
    <p>POTUS Watch Daily does not condone, glorify, dismiss, or exploit armed conflict of any kind. Coverage of wars is strictly analytical and policy-focused.</p>
    <h2>Contact</h2>
    <p>Questions? <a href="mailto:potuswatchdaily@gmail.com">potuswatchdaily@gmail.com</a></p>
  </main>
  <Footer />
</BaseLayout>
<style>
.page { max-width: 740px; margin: 0 auto; padding: 56px 24px 100px; }
.eyebrow { font-size: 10px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: var(--accent-text); margin-bottom: 16px; }
h1 { font-family: 'Playfair Display', serif; font-size: 38px; font-weight: 900; color: #fff; margin-bottom: 8px; }
h2 { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 700; color: #ddd; margin: 32px 0 10px; }
.updated { font-size: 12px; color: var(--text-3); margin-bottom: 20px; }
hr { border: none; border-top: 1px solid #1e1e1e; margin: 20px 0 28px; }
p { font-size: 14px; color: var(--text-3); line-height: 1.8; margin-bottom: 14px; }
a { color: var(--accent-text); }
</style>
