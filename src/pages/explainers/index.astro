---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout
  title="Explainers — POTUS Watch Daily"
  description="Plain-English explainers on the foreign policy issues that matter. Iran, NATO, U.S.-China relations, and more — background and context without the jargon."
  canonical="https://www.potuswatchdaily.com/explainers/"
>
  <Masthead backLink="/" backLabel="← Back to feed" />
  <div class="page">
    <div class="eyebrow">Explainers</div>
    <h1>Background &amp; Context</h1>
    <p class="page-sub">The stories behind the headlines. Plain-English explainers on the foreign policy issues that shape the dispatches we publish every day.</p>
    <div class="explainer-grid">
      <a class="explainer-card" href="/explainers/iran-nuclear-program">
        <div class="card-region">Iran</div>
        <div class="card-title">The Iran Nuclear File: A Plain-English Timeline</div>
        <div class="card-desc">From the Shah's American-supplied reactors to the JCPOA collapse — how one of the world's most consequential diplomatic standoffs actually developed.</div>
        <div class="card-read">Read explainer →</div>
      </a>
      <a class="explainer-card" href="/explainers/nato-article-5">
        <div class="card-region">NATO</div>
        <div class="card-title">What NATO's Article 5 Actually Means — and When It Applies</div>
        <div class="card-desc">The most invoked and least understood clause in modern diplomacy. What it says, what it doesn't, and what happens when it's triggered.</div>
        <div class="card-read">Read explainer →</div>
      </a>
      <a class="explainer-card" href="/explainers/us-china-relations">
        <div class="card-region">China</div>
        <div class="card-title">The U.S.-China Rivalry: How Two Powers Ended Up Here</div>
        <div class="card-desc">For thirty years, Washington bet that economic integration would moderate China's politics. It didn't. Here is how that assumption collapsed.</div>
        <div class="card-read">Read explainer →</div>
      </a>
    </div>
  </div>
  <Footer />
</BaseLayout>
<style>
.page { max-width: 900px; margin: 0 auto; padding: 56px 24px 100px; }
.eyebrow { font-size: 9px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #cc0000; margin-bottom: 12px; }
h1 { font-family: 'Playfair Display', serif; font-size: 36px; font-weight: 900; color: #fff; margin-bottom: 8px; }
.page-sub { font-size: 14px; color: #555; margin-bottom: 48px; line-height: 1.6; }
.explainer-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; }
.explainer-card { background: #0e0e0e; border: 1px solid #1e1e1e; border-top: 3px solid #cc0000; padding: 28px; text-decoration: none; display: block; transition: border-color 0.15s; }
.explainer-card:hover { border-color: #cc0000; }
.card-region { font-size: 9px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #cc0000; margin-bottom: 12px; }
.card-title { font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700; color: #fff; line-height: 1.3; margin-bottom: 10px; }
.card-desc { font-size: 13px; color: #666; line-height: 1.6; }
.card-read { font-size: 11px; color: #cc0000; margin-top: 16px; letter-spacing: 0.5px; }
</style>
