---
import { env } from 'cloudflare:workers';
import { createClient } from '@supabase/supabase-js';
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import { sourceLabel, isRoutineNotice } from '../lib/quality';
import { topicsFor } from '../lib/topics';
import { presidentialActions, agencyNotices, fmtDate } from '../lib/actions';

const supabase = createClient(env.SUPABASE_URL, env.SUPABASE_KEY);

const [{ data: articles = [] }, actions, notices] = await Promise.all([
  supabase.from('articles').select('id,title,slug,excerpt,region,date,time,sources').order('id', { ascending: false }).limit(80),
  presidentialActions(40),
  agencyNotices(12),
]);

// Routine list-maintenance pieces stay on their own pages but do not lead the front page.
// Older general foreign-policy pieces (UN debates and the like) stay in the archive;
// the front page shows only what fits the tariffs, trade and sanctions focus.
const list = (articles ?? []).filter(a => !isRoutineNotice(a.title) && (topicsFor(a.title).length > 0 || /whitehouse|ustr/.test(String(a.sources))));
const lead = list[0];
const rest = list.slice(1, 16);
const sidebarActions = actions.filter(a => a.tag !== 'Other').slice(0, 7);
const sidebarNotices = notices.slice(0, 6);

const tagOf = (a: any) => topicsFor(a.title)[0]?.name.split(':')[0] ?? a.region ?? 'Analysis';

const safeJsonLd = (o: unknown) => JSON.stringify(o)
  .replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');

const websiteLd = {
  "@context": "https://schema.org", "@type": "WebSite",
  "name": "POTUS Watch Daily",
  "url": "https://www.potuswatchdaily.com",
  "description": "Tracking every presidential action on tariffs, trade and sanctions, and what each one changes.",
  "publisher": { "@id": "https://www.potuswatchdaily.com/#org" }
};

const organizationLd = {
  "@context": "https://schema.org", "@type": "NewsMediaOrganization",
  "@id": "https://www.potuswatchdaily.com/#org",
  "name": "POTUS Watch Daily",
  "url": "https://www.potuswatchdaily.com",
  "logo": { "@type": "ImageObject", "url": "https://www.potuswatchdaily.com/logo-v3.png", "width": 1200, "height": 208 },
  "sameAs": ["https://twitter.com/POTUSwatch"],
  "foundingDate": "2026",
  "knowsAbout": ["Executive Orders", "Tariffs", "Sanctions", "Export Controls", "Trade Policy", "U.S. Foreign Policy"],
  "contactPoint": { "@type": "ContactPoint", "email": "potuswatchdaily@gmail.com", "contactType": "editorial" },
  "publishingPrinciples": "https://www.potuswatchdaily.com/editorial",
  "ethicsPolicy": "https://www.potuswatchdaily.com/editorial",
  "masthead": "https://www.potuswatchdaily.com/about",
  "missionCoveragePrioritiesPolicy": "https://www.potuswatchdaily.com/editorial"
};
---
<BaseLayout
  title="POTUS Watch Daily: Presidential Action on Tariffs, Trade and Sanctions"
  description="Tracking every executive order, proclamation and agency action on tariffs, trade and sanctions, with analysis of what each one changes."
  canonical="https://www.potuswatchdaily.com/"
  ogImage="https://www.potuswatchdaily.com/og-default.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={safeJsonLd(websiteLd)} />
    <script type="application/ld+json" set:html={safeJsonLd(organizationLd)} />
  </Fragment>

  <Masthead />

  <main id="main" class="home" tabindex="-1">
    <section class="intro">
      <p class="eyebrow">POTUS Watch Daily</p>
      <h1>What the President signs, and what it does to tariffs, trade and sanctions.</h1>
      <p class="intro-sub">Every executive order, proclamation and agency action, explained from the primary document. <a href="/tracker">Open the tracker →</a></p>
    </section>

    <div class="cols">
      <div class="main-col">
        {lead && (
          <a class="lead-card" href={`/article/${lead.slug}`}>
            <span class="kicker">{tagOf(lead)} · {sourceLabel(lead.sources, lead.region)}</span>
            <h2>{lead.title}</h2>
            <p>{lead.excerpt}</p>
            <span class="meta">{lead.date}{lead.time ? ` · ${lead.time} UTC` : ''} · Read the analysis →</span>
          </a>
        )}

        <h2 class="block-title">Latest analysis</h2>
        <ul class="feed">
          {rest.map(a => (
            <li>
              <a href={`/article/${a.slug}`}>
                <span class="kicker">{tagOf(a)}</span>
                <span class="f-title">{a.title}</span>
                <span class="f-ex">{a.excerpt}</span>
                <span class="meta">{a.date}{a.time ? ` · ${a.time} UTC` : ''}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="more"><a href="/archive">Browse the full archive →</a></p>
      </div>

      <aside class="side" aria-label="Tracker">
        <section class="panel">
          <h2 class="block-title">Presidential actions</h2>
          {sidebarActions.length === 0 && <p class="empty">Loading from the Federal Register is unavailable right now.</p>}
          <ul class="mini">
            {sidebarActions.map(a => (
              <li>
                <a href={a.url} target="_blank" rel="noopener">
                  <span class="m-top"><span class="m-date">{fmtDate(a.signed)}</span><span class={`tag tag-${a.tag.replace(' ', '-').toLowerCase()}`}>{a.tag}</span></span>
                  <span class="m-title">{a.title}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="panel-link" href="/tracker">Full tracker →</a>
        </section>

        <section class="panel">
          <h2 class="block-title">Agency notices</h2>
          <ul class="mini">
            {sidebarNotices.map(n => (
              <li>
                <a href={n.url} target="_blank" rel="noopener">
                  <span class="m-top"><span class="m-date">{fmtDate(n.date)}</span><span class="m-agency">{n.agency}</span></span>
                  <span class="m-title">{n.title}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="panel-link" href="/tracker">All notices →</a>
        </section>

        <section class="panel news">
          <h2 class="block-title">Weekly briefing</h2>
          <p>The week in presidential action on tariffs, trade and sanctions. Free, every Sunday.</p>
          <form id="subscribe-form" onsubmit="handleSubscribe(event)">
            <label for="sub-email" class="visually-hidden">Your email address</label>
            <input type="email" id="sub-email" name="email" autocomplete="email" placeholder="your@email.com" required>
            <button type="submit">Subscribe free</button>
          </form>
          <p id="sub-msg" role="status" aria-live="polite" style="font-size:12px;margin-top:10px;display:none"></p>
        </section>
      </aside>
    </div>
  </main>

  <Footer />

  <!-- BMC widget -->
  <script async data-name="BMC-Widget" data-cfasync="false" src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js" data-id="POTUSwatch" data-description="Support me on Buy me a coffee!" data-message="" data-color="#FF5F5F" data-position="Right" data-x_margin="18" data-y_margin="18"></script>

  <script is:inline>
    async function handleSubscribe(e) {
      e.preventDefault();
      var email = document.getElementById('sub-email').value;
      var msg = document.getElementById('sub-msg');
      var btn = e.target.querySelector('button');
      btn.textContent = 'Subscribing...'; btn.disabled = true;
      try {
        var r = await fetch('/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) });
        var d = await r.json();
        msg.style.display = 'block';
        if (r.ok) {
          msg.style.color = 'var(--success-text)'; msg.textContent = '✓ Subscribed. First dispatch incoming.';
          document.getElementById('subscribe-form').style.display = 'none';
        } else {
          msg.style.color = 'var(--danger-text)'; msg.textContent = d.error || 'Something went wrong. Try again.';
          btn.textContent = 'Subscribe free'; btn.disabled = false;
        }
      } catch {
        msg.style.display = 'block'; msg.style.color = 'var(--danger-text)'; msg.textContent = 'Connection error. Try again.';
        btn.textContent = 'Subscribe free'; btn.disabled = false;
      }
    }
  </script>
</BaseLayout>

<style>
.home { max-width: 1180px; margin: 0 auto; padding: 36px 24px 72px; }
.intro { padding-bottom: 28px; border-bottom: 1px solid var(--border); margin-bottom: 32px; }
.eyebrow { font: 700 10px IBM Plex Sans, sans-serif; letter-spacing: 2px; text-transform: uppercase; color: var(--accent-text); margin: 0 0 12px; }
.intro h1 { font-family: 'Newsreader', serif; font-weight: 900; font-size: clamp(28px, 4.2vw, 46px); line-height: 1.12; color: var(--text); margin: 0 0 14px; max-width: 880px; }
.intro-sub { font: 15px/1.6 IBM Plex Sans, sans-serif; color: var(--text-2); margin: 0; }
.intro-sub a { color: var(--accent-text); text-decoration: none; font-weight: 600; }
.cols { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 48px; align-items: start; }
.kicker { font: 700 10px IBM Plex Sans, sans-serif; letter-spacing: 1.5px; text-transform: uppercase; color: var(--accent-text); }
.meta { font: 12px IBM Plex Sans, sans-serif; color: var(--text-3); }
.lead-card { display: block; text-decoration: none; background: var(--bg-raised); border: 1px solid var(--border); border-left: 4px solid var(--accent); padding: 28px 30px; margin-bottom: 40px; }
.lead-card h2 { font-family: 'Newsreader', serif; font-weight: 900; font-size: clamp(24px, 3vw, 34px); line-height: 1.2; color: var(--text); margin: 10px 0 12px; }
.lead-card p { font: 17px/1.6 'Newsreader', Georgia, serif; color: var(--text-2); margin: 0 0 16px; }
.lead-card:hover h2 { color: var(--accent-text); }
.block-title { font: 700 11px IBM Plex Sans, sans-serif; letter-spacing: 2px; text-transform: uppercase; color: var(--text-3); margin: 0 0 14px; padding-bottom: 10px; border-bottom: 1px solid var(--border); }
.feed { list-style: none; margin: 0; padding: 0; }
.feed li { border-bottom: 1px solid var(--bg-sunk); }
.feed a { display: grid; gap: 6px; padding: 18px 0; text-decoration: none; }
.f-title { font-family: 'Newsreader', serif; font-weight: 700; font-size: 21px; line-height: 1.3; color: var(--text); }
.f-ex { font: 15px/1.55 'Newsreader', Georgia, serif; color: var(--text-2); }
.feed a:hover .f-title { color: var(--accent-text); }
.more { margin-top: 24px; font: 600 13px IBM Plex Sans, sans-serif; }
.more a { color: var(--accent-text); text-decoration: none; }
.side { display: grid; gap: 28px; position: sticky; top: 16px; }
.panel { background: var(--bg-card); border: 1px solid var(--border); padding: 20px; }
.mini { list-style: none; margin: 0 0 12px; padding: 0; }
.mini li { border-bottom: 1px solid var(--bg-sunk); }
.mini li:last-child { border-bottom: 0; }
.mini a { display: grid; gap: 4px; padding: 11px 0; text-decoration: none; }
.m-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
.m-date, .m-agency { font: 600 11px IBM Plex Sans, sans-serif; color: var(--text-3); }
.m-title { font: 14px/1.4 'Newsreader', Georgia, serif; color: var(--text); }
.mini a:hover .m-title { color: var(--accent-text); }
.panel-link { font: 600 12px IBM Plex Sans, sans-serif; color: var(--accent-text); text-decoration: none; }
.empty { font-size: 13px; color: var(--text-3); }
.tag { font: 700 9px IBM Plex Sans, sans-serif; letter-spacing: 1px; text-transform: uppercase; padding: 3px 7px; border-radius: 2px; background: var(--bg-sunk); color: var(--text-2); white-space: nowrap; }
.tag-tariffs { background: #FBEBC8; color: #6B4700; }
.tag-sanctions { background: #F8D9D1; color: #86250F; }
.tag-export-controls { background: #D6E6F7; color: #134377; }
.tag-trade { background: #D5EBDC; color: #14532F; }
.news { border-top: 3px solid var(--accent); }
.news p { font: 14px/1.6 IBM Plex Sans, sans-serif; color: var(--text-2); margin: 0 0 14px; }
.news form { display: grid; gap: 8px; }
.news input { background: var(--bg-card); border: 1px solid var(--border-ui); color: var(--text); padding: 11px 14px; border-radius: 3px; font: 13px IBM Plex Sans, sans-serif; }
.news button { background: var(--accent); color: #fff; border: 0; padding: 11px; border-radius: 3px; font: 600 13px IBM Plex Sans, sans-serif; cursor: pointer; }
@media (max-width: 900px) {
  .cols { grid-template-columns: 1fr; gap: 32px; }
  .side { position: static; }
  .home { padding: 24px 16px 56px; }
  .lead-card { padding: 20px; }
}
</style>
