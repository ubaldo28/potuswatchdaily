---
import { createClient } from '@supabase/supabase-js';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

const { env } = Astro.locals.runtime;
const supabase = createClient(env.SUPABASE_URL, env.SUPABASE_KEY);

const { data: articles = [] } = await supabase
  .from('articles')
  .select('id,title,slug,excerpt,region,date,time,image')
  .order('id', { ascending: false })
  .limit(24);

const list = articles ?? [];
const tickerTitles = list.slice(0, 8).map(a => a.title);

// JSON.stringify escapes quotes and backslashes but NOT '<', so a title
// containing </script> closes the element and injects markup. Article titles
// are LLM output derived from third-party feeds, so this is reachable.
const safeJsonLd = (o: unknown) => JSON.stringify(o)
  .replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');
---
<BaseLayout
  title="POTUS Watch Daily — Foreign Policy Intelligence"
  description="Independent foreign policy intelligence. Live analysis of Trump administration diplomacy, geopolitics, and global affairs."
  canonical="https://www.potuswatchdaily.com/"
  ogImage="https://www.potuswatchdaily.com/og-default.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json">{JSON.stringify({
      "@context":"https://schema.org","@type":"WebSite",
      "name":"POTUS Watch Daily",
      "url":"https://www.potuswatchdaily.com",
      "description":"Independent foreign policy intelligence. Live analysis of Trump administration diplomacy, geopolitics, and global affairs.",
      "potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https://www.potuswatchdaily.com/?q={search_term_string}"},"query-input":"required name=search_term_string"},
      "publisher":{"@type":"NewsMediaOrganization","name":"POTUS Watch Daily","url":"https://www.potuswatchdaily.com","logo":{"@type":"ImageObject","url":"https://www.potuswatchdaily.com/logo-v2.png","width":300,"height":52},"sameAs":["https://twitter.com/POTUSwatch"],"foundingDate":"2025","knowsAbout":["Foreign Policy","Geopolitics","US Diplomacy","Trump Administration","NATO","Middle East","China","Russia"]}
    })}</script>
    <script type="application/ld+json">{JSON.stringify({
      "@context":"https://schema.org","@type":"NewsMediaOrganization",
      "name":"POTUS Watch Daily",
      "url":"https://www.potuswatchdaily.com",
      "logo":{"@type":"ImageObject","url":"https://www.potuswatchdaily.com/logo-v2.png","width":300,"height":52},
      "sameAs":["https://twitter.com/POTUSwatch"],
      "contactPoint":{"@type":"ContactPoint","email":"potuswatchdaily@gmail.com","contactType":"editorial"},
      "publishingPrinciples":"https://www.potuswatchdaily.com/editorial",
      "ethicsPolicy":"https://www.potuswatchdaily.com/editorial",
      "masthead":"https://www.potuswatchdaily.com/about",
      "missionCoveragePrioritiesPolicy":"https://www.potuswatchdaily.com/editorial"
    })}</script>
  </Fragment>

  <!-- Masthead -->
  <header class="masthead">
    <div class="masthead-inner">
      <a href="/" style="display:flex;align-items:center;text-decoration:none;height:52px">
        <img src="/logo-v2.png" width="300" height="52" alt="POTUS Watch Daily" style="display:block">
      </a>
      <nav class="nav" id="nav" aria-label="Regions">
        <a href="/" data-filter="all" class="nav-active" aria-current="page">All</a>
        <a href="/region/americas" data-filter="Americas">Americas</a>
        <a href="/region/china" data-filter="China">China</a>
        <a href="/region/nato" data-filter="NATO">NATO</a>
        <a href="/region/iran" data-filter="Iran">Iran</a>
        <a href="/region/mideast" data-filter="Mideast">Mideast</a>
        <a href="/region/russia" data-filter="Russia">Russia</a>
        <a href="/region/trade" data-filter="Trade">Trade</a>
        <a href="/region/analysis" data-filter="Analysis">Analysis</a>
      </nav>
      <div class="masthead-right">
        <div class="search-input-wrap">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <label for="search-input" class="visually-hidden">Search dispatches</label>
          <input type="search" id="search-input" name="q" placeholder="Search…">
        </div>
        <a href="/newsletter" style="background:#cc0000;color:#fff;font-size:11px;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;padding:7px 14px;border-radius:3px;text-decoration:none;white-space:nowrap;flex-shrink:0">Subscribe</a>
        <div class="live-badge"><div class="dot"></div>Live</div>
      </div>
    </div>
  </header>

  <div style="background:#1a1a1a;border-bottom:1px solid #cc0000;padding:10px 24px;text-align:center">
    <p style="font-size:12px;color:#999;font-family:Inter,sans-serif;margin:0">POTUS Watch Daily covers foreign policy through an analytical lens. We do not glorify or exploit conflict. <a href="/editorial" style="color:#888;text-decoration:none">Editorial Standards</a></p>
  </div>

  <!-- Ticker -->
  <div class="ticker-wrap">
    <div class="ticker-label">Breaking</div>
    <div class="ticker-track">
      <div class="ticker-inner" id="ticker-inner">
        {tickerTitles.concat(tickerTitles).map(title => (
          <span>{title}</span>
        ))}
      </div>
    </div>
  </div>

  <!-- Hero -->
  {list.length > 0 && (
    <div class="hero-wrap" id="hero-wrap">
      <div class="hero">
        <!-- Main featured article -->
        <a class="hero-main" href={`/article/${list[0].slug}`}>
          {list[0].image
            ? <img class="hero-main-img" src={list[0].image} alt="" fetchpriority="high" />
            : <div class="hero-placeholder" style="height:480px"><span class="hero-placeholder-text">{(list[0].region||'POTUS Watch').toUpperCase()}</span></div>
          }
          <div class="overlay">
            <div class="tag">{list[0].region || 'World'}</div>
            <div class="card-title">{list[0].title}</div>
            <div class="card-excerpt">{list[0].excerpt || ''}</div>
          </div>
        </a>
        <!-- Side articles -->
        <div class="hero-side">
          {list.slice(1, 3).map(a => (
            <a class="hero-small" href={`/article/${a.slug}`}>
              {a.image
                ? <img class="hero-small-img" src={a.image} alt="" loading="eager" />
                : <div class="hero-placeholder" style="height:100%;min-height:200px"><span class="hero-placeholder-text" style="font-size:11px">{(a.region||'POTUS Watch').toUpperCase()}</span></div>
              }
              <div class="overlay">
                <div class="tag">{a.region || 'World'}</div>
                <div class="card-title">{a.title}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  <!-- Grid -->
  <main id="main" class="grid-wrap" tabindex="-1">
    <h1 class="site-h1">Foreign Policy Intelligence, Updated Hourly</h1>
    <p class="site-h1-sub">Independent analysis of U.S. diplomacy, great-power competition, and global affairs.</p>

    <div class="section-header">
      <span class="section-title" id="section-title">Latest Dispatches</span>
      <div class="section-line"></div>
    </div>

    <div id="grid" class="grid">
      {list.map((a, i) => (
        <>
          <a
            class="card"
            href={`/article/${a.slug}`}
            data-region={(a.region || '').toLowerCase()}
            data-search={`${(a.title || '').toLowerCase()} ${(a.excerpt || '').toLowerCase()}`}
          >
            {a.image
              ? <img class="card-img" src={a.image} alt="" loading={i < 6 ? 'eager' : 'lazy'} />
              : <div class="card-placeholder"><div class="card-placeholder-inner">{(a.region || 'POTUS Watch').toUpperCase()}</div></div>
            }
            <div class="card-body">
              <div class="tag">{a.region || 'World'}</div>
              <div class="card-title">{a.title}</div>
              <div class="card-excerpt">{a.excerpt || ''}</div>
              <div class="card-meta">{a.date || ''}{a.time ? ` · ${a.time}` : ''}</div>
            </div>
          </a>
          {i === 5 && (
            <div class="affiliate-banner" id="affiliate-banner" style="grid-column:1/-1;background:#0e0e0e;border:1px solid #1e1e1e;border-left:3px solid #cc0000;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
              <div>
                <p style="font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color: var(--accent-text);margin-bottom:4px;font-family:'Inter',sans-serif">Sponsored · Affiliate Disclosure</p>
                <p style="font-size:13px;color:#aaa;font-family:'Inter',sans-serif;line-height:1.5;margin:0">With global instability rising, many readers are preparing. <a href="https://amzn.to/4cgkdM3" target="_blank" rel="noopener nofollow sponsored" style="color:#fff;text-decoration:underline;text-underline-offset:3px">View the #1 rated emergency survival kit →</a></p>
              </div>
            </div>
          )}
        </>
      ))}
      <p id="no-results" style="display:none;color:#555;font-size:14px;padding:40px 0;grid-column:1/-1;text-align:center">No dispatches found for this filter.</p>
    </div>

    <div style="text-align:center;padding:32px 0 48px">
      <button id="load-more-btn" style="background:none;border:1px solid #2a2a2a;color:#555;padding:10px 32px;font-size:12px;font-family:'Inter',sans-serif;cursor:pointer;border-radius:3px;letter-spacing:0.5px;transition:all 0.15s" onmouseover="this.style.color='#fff';this.style.borderColor='#555'" onmouseout="this.style.color='#555';this.style.borderColor='#2a2a2a'">Load more dispatches</button>
    </div>
  </div>

  <!-- Newsletter CTA -->
  <div style="background:#111;border-top:3px solid #cc0000;border-bottom:1px solid #1e1e1e;padding:40px 24px;text-align:center">
    <p style="font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color: var(--accent-text);margin-bottom:12px;font-family:'Inter',sans-serif">Free Newsletter</p>
    <h2 style="font-family:'Playfair Display',serif;font-size:26px;font-weight:900;color:#fff;margin-bottom:10px">Stay ahead of the world</h2>
    <p style="font-size:14px;color:#666;margin-bottom:24px;font-family:'Inter',sans-serif;line-height:1.6;max-width:460px;margin-left:auto;margin-right:auto">Weekly foreign policy intelligence. No spin, no agenda. Free.</p>
    <form id="subscribe-form" style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center;max-width:460px;margin:0 auto" onsubmit="handleSubscribe(event)">
      <label for="sub-email" class="visually-hidden">Your email address</label>
        <input type="email" id="sub-email" name="email" autocomplete="email" placeholder="your@email.com" required style="flex:1;min-width:200px;background:#111;border:1px solid #333;color:#fff;padding:12px 16px;border-radius:3px;font-size:13px;font-family:'Inter',sans-serif;outline:none">
      <button type="submit" style="background:#cc0000;color:#fff;border:none;padding:12px 24px;border-radius:3px;font-size:13px;font-weight:600;font-family:'Inter',sans-serif;cursor:pointer;letter-spacing:0.5px">Subscribe free</button>
    </form>
    <p id="sub-msg" style="font-size:12px;margin-top:10px;display:none"></p>
  </main>

  <Footer />

  <!-- Cookie banner -->
  <div class="cookie-banner" id="cookie-banner">
    <p>We use cookies to serve personalised ads and improve your experience. This includes Google AdSense. <a href="/privacy">Privacy Policy</a> · <a href="https://adssettings.google.com" target="_blank">Opt out</a>.</p>
    <div class="cookie-actions">
      <button class="btn-accept" onclick="acceptCookies()">Accept</button>
      <button class="btn-decline" onclick="document.getElementById('cookie-banner').style.display='none'">Decline</button>
    </div>
  </div>

  <!-- BMC widget -->
  <script async data-name="BMC-Widget" data-cfasync="false" src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js" data-id="POTUSwatch" data-description="Support me on Buy me a coffee!" data-message="" data-color="#FF5F5F" data-position="Right" data-x_margin="18" data-y_margin="18"></script>

  <script is:inline>
    // --- Filter & Search ---
    var currentFilter = 'all';
    var visibleCount = 21;
    var allCards = Array.from(document.querySelectorAll('#grid .card'));

    function applyFilters() {
      var searchVal = document.getElementById('search-input').value.toLowerCase().trim();
      var shown = 0;
      allCards.forEach(function(card) {
        var regionMatch = currentFilter === 'all' || card.dataset.region === currentFilter.toLowerCase();
        var searchMatch = !searchVal || card.dataset.search.includes(searchVal);
        var withinLimit = shown < visibleCount;
        if (regionMatch && searchMatch) {
          if (withinLimit) {
            card.style.display = 'block';
            shown++;
          } else {
            card.style.display = 'none';
          }
        } else {
          card.style.display = 'none';
        }
      });

      var noResults = document.getElementById('no-results');
      if (shown === 0 && (currentFilter !== 'all' || document.getElementById('search-input').value.trim())) {
        noResults.style.display = 'block';
      } else {
        noResults.style.display = 'none';
      }

      var total = allCards.filter(function(c) {
        var regionMatch = currentFilter === 'all' || c.dataset.region === currentFilter.toLowerCase();
        var searchMatch = !searchVal || c.dataset.search.includes(searchVal);
        return regionMatch && searchMatch;
      }).length;
      var loadBtn = document.getElementById('load-more-btn');
      loadBtn.style.display = total > visibleCount ? 'inline-block' : 'none';

      var secTitle = document.getElementById('section-title');
      secTitle.textContent = currentFilter === 'all' ? 'Latest Dispatches' : currentFilter + ' Dispatches';
    }

    // Nav filter clicks
    document.querySelectorAll('#nav a').forEach(function(a) {
      a.addEventListener('click', function(e) {
        e.preventDefault();
        currentFilter = this.dataset.filter;
        visibleCount = 21;
        document.querySelectorAll('#nav a').forEach(function(n) { n.classList.remove('nav-active'); });
        document.querySelectorAll('#nav a').forEach(function (n) { n.removeAttribute('aria-current'); });
        this.classList.add('nav-active');
        this.setAttribute('aria-current', 'page');
        document.getElementById('search-input').value = '';
        applyFilters();
      });
    });

    // Search
    document.getElementById('search-input').addEventListener('input', function() {
      visibleCount = 21;
      applyFilters();
    });
    document.getElementById('search-input').addEventListener('keydown', function(e) {
      if (e.key === 'Escape') { this.value = ''; applyFilters(); }
    });

    // Load more
    document.getElementById('load-more-btn').addEventListener('click', function() {
      visibleCount += 21;
      applyFilters();
    });

    // Initial state — hide cards beyond 21
    applyFilters();

    // --- Cookie banner ---
    function acceptCookies() {
      try { localStorage.setItem('cookies', '1'); } catch(e) {}
      document.getElementById('cookie-banner').style.display = 'none';
    }
    setTimeout(function() {
      try { if (!localStorage.getItem('cookies')) document.getElementById('cookie-banner').style.display = 'flex'; } catch(e) {}
    }, 3000);

    // --- Subscribe ---
    async function handleSubscribe(e) {
      e.preventDefault();
      var email = document.getElementById('sub-email').value;
      var msg = document.getElementById('sub-msg');
      var btn = e.target.querySelector('button');
      btn.textContent = 'Subscribing...'; btn.disabled = true;
      try {
        var r = await fetch('/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) });
        var d = await r.json();
        msg.style.display = 'block';
        if (r.ok) {
          msg.style.color = '#4caf50'; msg.textContent = '✓ Subscribed. First dispatch incoming.';
          document.getElementById('subscribe-form').style.display = 'none';
        } else {
          msg.style.color = '#cc0000'; msg.textContent = d.error || 'Something went wrong. Try again.';
          btn.textContent = 'Subscribe free'; btn.disabled = false;
        }
      } catch {
        msg.style.display = 'block'; msg.style.color = '#cc0000'; msg.textContent = 'Connection error. Try again.';
        btn.textContent = 'Subscribe free'; btn.disabled = false;
      }
    }
  </script>
</BaseLayout>
