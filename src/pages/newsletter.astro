---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="Subscribe — POTUS Watch Daily"
  description="Get weekly foreign policy coverage delivered to your inbox. Independent analysis of the Trump administration, global diplomacy, and geopolitics."
  canonical="https://www.potuswatchdaily.com/newsletter"
>
  <Masthead backLink="/" backLabel="← Back to feed" />

  <main id="main" class="page" tabindex="-1">
    <div class="eyebrow">Free Weekly Email</div>
    <h1>One email. Every week. Worth reading.</h1>
    <p class="subtitle">A short weekly briefing on what's happening in U.S. foreign policy and global affairs. No spin, just what matters and why.</p>

    <div class="form-wrap">
      <label class="form-label" for="nl-email">Your email address</label>
      <form id="nl-subscribe-form">
        <div class="form-row">
          <input type="email" id="nl-email" class="form-input" placeholder="you@example.com" required autocomplete="email">
          <button type="submit" class="form-btn" id="nl-btn">Subscribe Free</button>
        </div>
        <p class="form-note">Free. Weekly. Unsubscribe anytime — no questions asked.</p>
      </form>
      <div id="sub-msg" role="status" aria-live="polite"></div>
    </div>

    <div class="features">
      <div class="feature"><div class="feature-title">Sent every week</div><div class="feature-desc">One email every Thursday covering the week's most important foreign policy stories.</div></div>
      <div class="feature"><div class="feature-title">Real analysis</div><div class="feature-desc">What happened, the context behind it, and what it likely means going forward.</div></div>
      <div class="feature"><div class="feature-title">Short and readable</div><div class="feature-desc">Written to be read in under ten minutes. No padding, no repeating yourself.</div></div>
      <div class="feature"><div class="feature-title">Free</div><div class="feature-desc">Always free. No subscription tiers, no credit card, nothing to upgrade.</div></div>
    </div>

    <hr class="divider">

    <div class="sample-label">What you'll get</div>
    <div class="sample-issue">
      <div class="sample-header">
        <div class="sample-header-title">POTUS Watch Daily</div>
        <div class="sample-header-sub">Weekly Briefing · Every Thursday</div>
      </div>
      <div class="sample-body">
        <div class="sample-section-label">From the Editor</div>
        <div class="sample-excerpt">A short note on the week's most important foreign policy development and what it means going forward.</div>
        <hr class="sample-divider">
        <div class="sample-section-label">Lead Story</div>
        <div class="sample-headline">The week's defining story — with context, analysis, and what to watch next.</div>
        <hr class="sample-divider">
        <div class="sample-section-label">Also This Week</div>
        <div class="sample-excerpt" style="color:#666">Three to five additional stories you need to know — NATO, China, Iran, Russia, Trade, and more.</div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
.page { max-width: 680px; margin: 0 auto; padding: 80px 24px 120px; }
.eyebrow { font-size: 10px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: var(--accent-text); margin-bottom: 20px; }
h1 { font-family: 'Playfair Display', serif; font-size: 48px; font-weight: 900; line-height: 1.1; color: #fff; margin-bottom: 20px; }
@media (max-width: 600px) { h1 { font-size: 34px; } }
.subtitle { font-size: 17px; color: var(--text-3); line-height: 1.7; margin-bottom: 48px; max-width: 520px; }
.form-wrap { background: #111; border: 1px solid #1e1e1e; border-radius: 6px; padding: 36px; margin-bottom: 48px; }
.form-label { font-size: 11px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: var(--text-3); margin-bottom: 10px; display: block; }
.form-row { display: flex; gap: 10px; flex-wrap: wrap; }
.form-input { flex: 1; min-width: 200px; background: #0a0a0a; border: 1px solid var(--border-ui); color: #fff; padding: 14px 16px; border-radius: 3px; font-size: 14px; font-family: 'Inter', sans-serif;  transition: border-color 0.2s; }
.form-input:focus { border-color: var(--text-3); }
.form-input::placeholder { color: var(--text-3); }
.form-btn { background: #cc0000; color: #fff; border: none; padding: 14px 28px; border-radius: 3px; font-size: 13px; font-weight: 700; font-family: 'Inter', sans-serif; cursor: pointer; letter-spacing: 0.5px; text-transform: uppercase; transition: background 0.15s; }
.form-btn:hover { background: #aa0000; }
.form-btn:disabled { opacity: 0.5; cursor: not-allowed; }
.form-note { font-size: 11px; color: var(--text-3); margin-top: 14px; }
#sub-msg { font-size: 13px; margin-top: 16px; display: none; padding: 12px 16px; border-radius: 3px; }
#sub-msg.success { background: rgba(76,175,80,0.1); border: 1px solid rgba(76,175,80,0.2); color: #4caf50; }
#sub-msg.error { background: rgba(204,0,0,0.1); border: 1px solid rgba(204,0,0,0.2); color: #cc4444; }
.features { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 48px; }
@media (max-width: 500px) { .features { grid-template-columns: 1fr; } }
.feature { border-left: 2px solid #cc0000; padding-left: 16px; }
.feature-title { font-size: 13px; font-weight: 600; color: #fff; margin-bottom: 4px; }
.feature-desc { font-size: 12px; color: var(--text-3); line-height: 1.6; }
.divider { border: none; border-top: 1px solid #1a1a1a; margin: 48px 0; }
.sample-label { font-size: 10px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--text-3); margin-bottom: 20px; }
.sample-issue { background: #111; border: 1px solid #1e1e1e; border-radius: 6px; overflow: hidden; }
.sample-header { background: #cc0000; padding: 20px 24px; }
.sample-header-title { font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 900; color: #fff; }
.sample-header-sub { font-size: 11px; color: rgba(255,255,255,0.7); margin-top: 4px; letter-spacing: 1px; text-transform: uppercase; }
.sample-body { padding: 24px; }
.sample-section-label { font-size: 9px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--accent-text); margin-bottom: 8px; }
.sample-headline { font-family: 'Playfair Display', serif; font-size: 16px; font-weight: 700; color: #e8e8e8; line-height: 1.4; margin-bottom: 6px; }
.sample-excerpt { font-size: 12px; color: var(--text-3); line-height: 1.6; }
.sample-divider { border: none; border-top: 1px solid #1e1e1e; margin: 16px 0; }
</style>

<script is:inline>
async function handleNLSubscribe(e) {
  e.preventDefault();
  const email = document.getElementById('nl-email').value;
  const msg = document.getElementById('sub-msg');
  const btn = document.getElementById('nl-btn');
  btn.textContent = 'Subscribing...'; btn.disabled = true;
  try {
    const r = await fetch('/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) });
    const d = await r.json();
    msg.style.display = 'block';
    if (r.ok) {
      msg.className = 'success'; msg.textContent = '✓ You\'re subscribed. First issue coming Thursday.';
      document.getElementById('nl-subscribe-form').style.display = 'none';
    } else {
      msg.className = 'error'; msg.textContent = d.error || 'Something went wrong. Try again.';
      btn.textContent = 'Subscribe Free'; btn.disabled = false;
    }
  } catch {
    msg.style.display = 'block'; msg.className = 'error'; msg.textContent = 'Connection error. Try again.';
    btn.textContent = 'Subscribe Free'; btn.disabled = false;
  }
}

document.getElementById('nl-subscribe-form').addEventListener('submit', handleNLSubscribe);
</script>
