---
import { env } from 'cloudflare:workers';
import { createClient } from '@supabase/supabase-js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import Footer from '../../components/Footer.astro';
import { getOrder, fmtDate } from '../../lib/actions';
import { isRoutineNotice } from '../../lib/quality';

const SITE_URL = 'https://www.potuswatchdaily.com';
const doc = String(Astro.params.doc || '');
const o = await getOrder(doc);
if (!o) return new Response('Not found', { status: 404, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });

const longDate = (iso: string) => {
  const d = new Date(`${iso}T12:00:00Z`);
  return isNaN(d.getTime()) ? iso : d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
};

// Our own coverage of this document, matched on its number when it has one.
const num = (o.label.match(/\d{3,6}$/) || [])[0];
let related: any[] = [];
if (num) {
  try {
    const supabase = createClient(env.SUPABASE_URL, env.SUPABASE_KEY);
    const { data } = await supabase.from('articles').select('title,slug,excerpt,date')
      .or(`title.ilike.%${o.kind} ${num}%,body.ilike.%${o.kind} ${num}%`)
      .is('removed_at', null).order('id', { ascending: false }).limit(5);
    related = (data ?? []).filter(a => !isRoutineNotice(a.title));
  } catch {}
}

// Official text, as paragraphs. Federal Register plain text wraps lines inside paragraphs.
const paras = o.text.split(/\n{2,}/).map(p => p.replace(/\s*\n\s*/g, ' ').trim())
  .filter(p => p && !/^(Billing code|Federal Register\/|\[FR Doc|Vol\.|Presidential Documents)/i.test(p));
const textWords = paras.join(' ').split(/\s+/).filter(Boolean).length;
const lead = paras.find(p => p.length > 120) || o.title;
const metaDesc = `${o.label}: ${o.title}. Signed ${longDate(o.signed)}. The official text, what it covers, and our coverage.`.slice(0, 300);
const thin = textWords < 150;
const canonical = `${SITE_URL}/order/${doc}`;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

const ld = {
  '@context': 'https://schema.org', '@type': 'Legislation',
  name: `${o.label}: ${o.title}`, legislationType: o.kind, legislationIdentifier: num || doc,
  legislationDate: o.signed, datePublished: o.published, url: canonical,
  legislationJurisdiction: 'US', publisher: { '@type': 'Organization', name: 'POTUS Watch Daily', url: SITE_URL },
  isBasedOn: o.htmlUrl,
};
const crumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Tracker', item: `${SITE_URL}/tracker` },
    { '@type': 'ListItem', position: 3, name: o.label, item: canonical },
  ],
};
const safeJsonLd = (x: unknown) => JSON.stringify(x).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');
---
<BaseLayout
  title={`${o.label}: ${o.title} | POTUS Watch Daily`}
  description={metaDesc}
  canonical={canonical}
  noIndex={thin}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={safeJsonLd(ld)} />
    <script type="application/ld+json" set:html={safeJsonLd(crumbs)} />
  </Fragment>
  <Masthead />
  <main id="main" class="order" tabindex="-1">
    <nav class="crumb"><a href="/tracker">Tracker</a> / <span>{o.label}</span></nav>
    <div class="eyebrow">{o.kind}{num ? ` ${num}` : ''}</div>
    <h1>{o.title}</h1>
    <dl class="facts">
      <div><dt>Document</dt><dd>{o.label}</dd></div>
      <div><dt>Signed</dt><dd>{longDate(o.signed)}</dd></div>
      <div><dt>Published in the Federal Register</dt><dd>{longDate(o.published)}</dd></div>
      {o.citation && <div><dt>Citation</dt><dd>{o.citation}</dd></div>}
      <div><dt>Topic</dt><dd>{o.tag}</dd></div>
    </dl>

    <p class="lead">{o.abstract || lead}</p>

    {related.length > 0 && (
      <section class="cover">
        <h2>Our coverage</h2>
        {related.map(a => (
          <a class="rel" href={`/article/${a.slug}`}>
            <span class="rt">{a.title}</span>
            {a.excerpt && <span class="rx">{a.excerpt}</span>}
          </a>
        ))}
      </section>
    )}

    <h2>Official text</h2>
    <p class="note">The text below is the {o.kind.toLowerCase()} as published in the Federal Register, a US government work in the public domain.
      <a href={o.htmlUrl} target="_blank" rel="noopener">View it on federalregister.gov</a>{o.pdfUrl && <> or <a href={o.pdfUrl} target="_blank" rel="noopener">download the PDF</a></>}.</p>
    <article class="text">
      {paras.map(p => <p set:html={esc(p)} />)}
    </article>

    <p class="src">Source: Federal Register document {doc}. See also the <a href="/tracker">full presidential actions tracker</a> and
      our <a href={`/topic/${o.tag === 'Tariffs' ? 'tariffs-trade-policy' : o.tag === 'Sanctions' ? 'sanctions-policy' : 'presidential-actions'}`}>coverage hub</a>.</p>
  </main>
  <Footer />
</BaseLayout>

<style>
.order { max-width: 760px; margin: 0 auto; padding: 40px 24px 96px; }
.crumb { font: 600 12px IBM Plex Sans, sans-serif; color: var(--text-3); margin-bottom: 18px; }
.crumb a { color: var(--accent-text); text-decoration: none; }
.eyebrow { font-size: 10px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--accent-text); margin-bottom: 10px; }
h1 { font-family: 'Newsreader', serif; font-size: 38px; font-weight: 900; line-height: 1.15; color: var(--text); margin: 0 0 22px; }
h2 { font-family: 'Newsreader', serif; font-size: 24px; color: var(--text); margin: 44px 0 10px; }
.facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 1px; background: var(--border); border: 1px solid var(--border); margin: 0 0 26px; }
.facts div { background: var(--bg); padding: 12px 14px; }
.facts dt { font: 700 10px IBM Plex Sans, sans-serif; letter-spacing: 1.2px; text-transform: uppercase; color: var(--text-3); margin-bottom: 4px; }
.facts dd { margin: 0; font-family: 'Newsreader', serif; font-size: 16px; color: var(--text); }
.lead { font-family: 'Newsreader', serif; font-size: 19px; line-height: 1.6; color: var(--text); margin: 0 0 8px; }
.note, .src { font-size: 12px; color: var(--text-3); line-height: 1.6; }
.note a, .src a { color: var(--accent-text); }
.rel { display: block; padding: 12px 0; border-bottom: 1px solid var(--bg-sunk); text-decoration: none; }
.rt { display: block; font-family: 'Newsreader', serif; font-size: 18px; color: var(--text); }
.rx { display: block; font-size: 13px; color: var(--text-2); margin-top: 4px; line-height: 1.5; }
.rel:hover .rt { color: var(--accent-text); }
.text p { font-family: 'Newsreader', serif; font-size: 17px; line-height: 1.7; color: var(--text); margin: 0 0 14px; }
</style>
