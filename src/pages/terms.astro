---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Terms of Service — POTUS Watch Daily" canonical="https://www.potuswatchdaily.com/terms">
  <Masthead backLink="/" backLabel="← Back to feed" />
  <div class="page">
    <div class="eyebrow">Legal</div>
    <h1>Terms of Service</h1>
    <p class="updated">Last updated: April 2026</p>
    <hr>
    <h2>Acceptance of Terms</h2>
    <p>By accessing and using POTUS Watch Daily, you agree to be bound by these Terms of Service.</p>
    <h2>Use of Content</h2>
    <p>All content published on POTUS Watch Daily is for informational purposes only. You may not reproduce, distribute, republish, or commercially exploit any content without prior written permission. Brief quotations with attribution are permitted for non-commercial purposes.</p>
    <h2>Disclaimer of Warranties</h2>
    <p>The Site is provided on an "as is" basis without warranties of any kind. We make no representations as to the accuracy, completeness, or timeliness of any content.</p>
    <h2>Limitation of Liability</h2>
    <p>POTUS Watch Daily and its operators shall not be liable for any direct, indirect, incidental, or consequential damages arising from your use of or reliance on this Site or its content.</p>
    <h2>Third Party Links and Content</h2>
    <p>The Site may contain links to third party websites provided for reference only. We have no control over and accept no responsibility for the content of third party sites.</p>
    <h2>Affiliate Relationships</h2>
    <p>This Site participates in affiliate programmes. Some links may result in a commission being earned at no additional cost to you. This does not influence our editorial content.</p>
    <h2>Advertising</h2>
    <p>This Site may display third party advertisements. Advertisers have no influence over our editorial content.</p>
    <h2>Privacy</h2>
    <p>Your use of the Site is also governed by our <a href="/privacy">Privacy Policy</a>, which is incorporated into these Terms of Service by reference.</p>
    <h2>Changes to Terms</h2>
    <p>We reserve the right to modify these Terms of Service at any time. Continued use of the Site following changes constitutes your acceptance of the revised terms.</p>
    <h2>Governing Law</h2>
    <p>These Terms shall be governed by the laws of the United States.</p>
    <h2>Contact</h2>
    <p>Questions? <a href="mailto:potuswatchdaily@gmail.com">potuswatchdaily@gmail.com</a></p>
  </div>
  <Footer />
</BaseLayout>
<style>
.page { max-width: 740px; margin: 0 auto; padding: 56px 24px 100px; }
.eyebrow { font-size: 10px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: var(--accent-text); margin-bottom: 16px; }
h1 { font-family: 'Playfair Display', serif; font-size: 38px; font-weight: 900; color: #fff; margin-bottom: 8px; }
h2 { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 700; color: #ddd; margin: 32px 0 10px; }
.updated { font-size: 12px; color: var(--text-3); margin-bottom: 20px; }
hr { border: none; border-top: 1px solid #1e1e1e; margin: 20px 0 28px; }
p { font-size: 14px; color: var(--text-3); line-height: 1.8; margin-bottom: 14px; }
a { color: var(--accent-text); }
</style>
