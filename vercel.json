{
  "framework": null,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/get-articles",
      "destination": "/api/articles"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/article/:slug",
      "destination": "/api/article?slug=:slug"
    },
    {
      "source": "/archive",
      "destination": "/api/archive"
    }
  ],
  "redirects": [
    {
      "source": "/ads.txt",
      "destination": "https://srv.adstxtmanager.com/19390/potuswatchdaily.com",
      "permanent": true
    }
  ]
}