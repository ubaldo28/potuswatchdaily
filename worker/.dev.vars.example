# Copy to worker/.dev.vars for `wrangler dev`. NEVER commit the real .dev.vars —
# the repo .gitignore already excludes .dev.vars* while allowing this example.
#
# In production these are Worker secrets, set with `wrangler secret put`.
UNSPLASH_ACCESS_KEY=...
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=...

# Optional. If set, enables POST /run?token=... to fire a generation by hand.
# Leave unset in production unless you want that endpoint live.
RUN_TOKEN=some-long-random-string
