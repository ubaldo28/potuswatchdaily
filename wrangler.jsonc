{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deliberately NOT "potuswatchdaily": that name is taken by the existing
  // Pages project, which stays up as the rollback target until the custom
  // domain is moved onto this Worker.
  "name": "potuswatchdaily-site",

  // Pinned on purpose. Without it, `wrangler deploy` targets whichever account
  // your global `wrangler login` happens to be on -- and if you work on more
  // than one project that is a coin flip. A wrong login now fails immediately
  // with "not a member of this account" instead of authenticating fine and
  // erroring deep inside the API, or worse, deploying somewhere unintended.
  "account_id": "7ded3077a7ce39644f81502fc5e09647",
  "compatibility_date": "2026-05-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Back on, deliberately. It was switched off because the preview hostname
  // served a full, indexable copy of every page and a canonical tag is a hint
  // rather than a directive -- but src/middleware.ts now sends
  // "X-Robots-Tag: noindex, nofollow" on every response whose Host is not the
  // canonical one, which IS a directive and covers this hostname.
  //
  // It needs to be reachable: potuswatchdaily.com is still served by the Pages
  // project, not by this Worker, so this hostname is the only way to see what
  // this Worker actually serves before the domain is moved onto it. Switching a
  // live domain onto a Worker nobody can load first is not a migration, it is a
  // coin toss. See RUNBOOK.md.
  "workers_dev": true,

  // Not secrets. Newsletter signups are added to the "General" list in Resend. The API
  // key and SUBSCRIBE_SECRET are secrets: set them in the dashboard, never here.
  "vars": {
    "RESEND_AUDIENCE_ID": "b5a76e2c-fbf4-43e7-8d01-e43b5e5e1162"
  },

  "observability": {
    "enabled": true
  }
}
